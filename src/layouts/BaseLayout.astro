---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { SITE_URL, site, mainLocation, type Location } from '../data/site';
import { businessSchema, websiteSchema, webpageSchema, breadcrumbSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  location?: Location;
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  published?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  location = mainLocation,
  schema = [],
  breadcrumbs,
  noindex = false,
  ogType = 'website',
  published,
} = Astro.props;

const brand = title.length + site.name.length + 3 <= 60 ? site.name : site.shortName;
const fullTitle = title.includes(site.shortName) ? title : `${title} | ${brand}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = new URL(image, SITE_URL).toString();

const graph = [
  businessSchema(),
  websiteSchema(),
  webpageSchema({ url: canonical, name: fullTitle, description, image: ogImage }),
  ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="author" content={site.name} />
    <meta name="geo.position" content={`${location.lat};${location.lng}`} />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#12382f" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Purify Air Duct Cleaning, serving Aventura and South Florida" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Purify Air Duct Cleaning, serving Aventura and South Florida" />
    {published && <meta property="article:published_time" content={published} />}
    {published && <meta property="article:modified_time" content={published} />}

    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content={location.city} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__motion) document.documentElement.classList.add('motion-off');
      }, 2500);
    </script>
    <slot name="head" />
  </head>
  <body class="pb-[calc(6.25rem+env(safe-area-inset-bottom))] lg:pb-0">
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
