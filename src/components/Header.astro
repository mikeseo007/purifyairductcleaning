---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, locations, regions, locationsByRegion } from '../data/site';
import { serviceGroups, servicesByGroup } from '../data/services';

const current = Astro.url.pathname;

const groups = serviceGroups.map((g) => ({
  ...g,
  links: servicesByGroup(g.id).map((s) => ({ href: s.path, label: s.name, icon: s.icon })),
}));
const locationGroups = regions.map((r) => ({
  ...r,
  links: locationsByRegion(r.id).map((l) => ({ href: l.path, label: l.city })),
}));
const allServicePaths = groups.flatMap((g) => g.links.map((l) => l.href));
const primaryGroups = groups.filter((g) => !g.secondary);
const secondaryGroups = groups.filter((g) => g.secondary);
const serviceColumns = (secondaryGroups.length
  ? [...primaryGroups.map((g) => [g]), secondaryGroups]
  : [...primaryGroups.slice(0, 2).map((g) => [g]), primaryGroups.slice(2)]
).filter((column) => column.length);

const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const servicesActive = isActive('/our-services/') || allServicePaths.includes(current);
const locationsActive = isActive('/service-areas/') || locations.some((l) => l.path !== '/' && current === l.path);

const links = [
  { href: '/about-us/', label: 'About' },
  { href: '/contact-us/', label: 'Contact' },
];
const overlay = false;
---

<div class="bg-navy-950 text-sm text-white/80">
  <div class="container-x flex h-10 items-center justify-between gap-4">
    <p class="flex min-w-0 items-center gap-2 truncate">
      <Icon name="pin" class="size-4 shrink-0 text-lime-400" />
      Serving Aventura, FL and Surrounding Areas
    </p>
    <a href={site.phoneHref} class="shrink-0 font-bold text-white">{site.phone}</a>
  </div>
</div>
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white" data-header>
  <div class="container-x relative flex h-20 items-center justify-between gap-3" data-header-bar>
    <a href="/" class="flex shrink-0 items-center" aria-label={`${site.name} home`}>
      <Logo size="lg" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-0.5">
        <li>
          <a href="/" class:list={['nav-link block rounded-lg px-3 py-2 text-[15px] font-medium transition', overlay ? 'text-white hover:text-white/80' : current === '/' ? 'text-sky-500' : 'text-navy-800 hover:text-sky-500']} aria-current={current === '/' ? 'page' : undefined}>Home</a>
        </li>
        <li>
          <a href="/about-us/" class:list={['nav-link block rounded-lg px-3 py-2 text-[15px] font-medium whitespace-nowrap transition', overlay ? 'text-white hover:text-white/80' : isActive('/about-us/') ? 'is-active text-sky-500' : 'text-navy-900 hover:text-sky-500']} aria-current={current === '/about-us/' ? 'page' : undefined}>About</a>
        </li>
        <li class="group">
          <a
            href="/our-services/"
            class:list={['nav-link flex items-center gap-1 rounded-lg px-3 py-2 text-[15px] font-medium transition', overlay ? 'text-white hover:text-white/80' : servicesActive ? 'is-active text-sky-500' : 'text-navy-900 hover:text-sky-500']}
          >
            Services
            <Icon name="chevronDown" class="size-4 transition group-hover:rotate-180" />
          </a>
          <div class="mega invisible absolute inset-x-0 top-full z-50 pt-2 opacity-0 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
            <div class="mx-auto grid max-w-5xl grid-cols-[1fr_1fr_0.8fr] gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_24px_60px_-30px_rgb(18_56_47/0.45)]">
              {
                serviceColumns.map((column) => (
                  <div class:list={['space-y-5', column[0].secondary && 'border-l border-slate-100 pl-6']}>
                    {column.map((g) => (
                      <div>
                        <a href={g.hub} class:list={['mb-2 block font-bold', g.secondary ? 'text-sm text-muted hover:text-navy-700' : 'text-navy-900 hover:text-sky-500']}>
                          {g.name}
                        </a>
                        <ul class="space-y-0.5">
                          {g.links.map((c) => (
                            <li>
                              <a
                                href={c.href}
                                class:list={[
                                  'flex items-center gap-2.5 rounded-xl font-medium transition hover:bg-sky-50 hover:text-navy-700',
                                  g.secondary ? 'px-3 py-1.5 text-sm' : 'px-3 py-2 text-[15px]',
                                  current === c.href ? 'bg-sky-50 text-navy-700' : 'text-ink',
                                ]}
                              >
                                <Icon name={c.icon} class:list={['shrink-0 text-sky-500', g.secondary ? 'size-4' : 'size-5']} />
                                {c.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ))
              }
              <a href="/our-services/" class="col-span-3 flex items-center justify-center gap-2 rounded-xl bg-sky-50 py-3 font-bold text-navy-800 transition hover:bg-sky-100">
                View all services <Icon name="arrowRight" class="size-4" />
              </a>
            </div>
          </div>
        </li>
        <li class="group">
          <a
            href="/service-areas/"
            class:list={['nav-link flex items-center gap-1 rounded-lg px-3 py-2 text-[15px] font-medium whitespace-nowrap transition', overlay ? 'text-white hover:text-white/80' : locationsActive ? 'is-active text-sky-500' : 'text-navy-900 hover:text-sky-500']}
          >
            Service Areas
            <Icon name="chevronDown" class="size-4 transition group-hover:rotate-180" />
          </a>
          <div class="mega invisible absolute inset-x-0 top-full z-50 pt-2 opacity-0 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
            <div class="mx-auto grid max-w-4xl grid-cols-3 gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_24px_60px_-30px_rgb(18_56_47/0.45)]">
              {
                locationGroups.map((r, i) => (
                  <div class:list={[i > 0 && 'border-l border-slate-100 pl-6']}>
                    <p class="mb-2 px-3 text-xs font-bold tracking-wider whitespace-nowrap text-muted uppercase">{r.short}</p>
                    <ul class="space-y-0.5">
                      {r.links.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            class:list={[
                              'flex items-center gap-2 rounded-xl px-3 py-1.5 text-[15px] font-medium transition hover:bg-sky-50 hover:text-navy-700',
                              current === c.href ? 'bg-sky-50 text-navy-700' : 'text-ink',
                            ]}
                          >
                            <Icon name="pin" class="size-4 shrink-0 text-sky-500" />
                            {c.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
              <a href="/service-areas/" class="col-span-3 flex items-center justify-center gap-2 rounded-xl bg-sky-50 py-3 font-bold text-navy-800 transition hover:bg-sky-100">
                View all service areas <Icon name="arrowRight" class="size-4" />
              </a>
            </div>
          </div>
        </li>
        <li>
          <a
            href="/blog/"
            class:list={['nav-link block rounded-lg px-3 py-2 text-[15px] font-medium whitespace-nowrap transition', overlay ? 'text-white hover:text-white/80' : isActive('/blog/') ? 'is-active text-sky-500' : 'text-navy-900 hover:text-sky-500']}
            aria-current={isActive('/blog/') ? 'page' : undefined}
          >
            Blog
          </a>
        </li>
        {
          links.filter((item) => item.href === '/contact-us/').map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link block rounded-lg px-3 py-2 text-[15px] font-medium whitespace-nowrap transition', overlay ? 'text-white hover:text-white/80' : isActive(item.href) ? 'is-active text-sky-500' : 'text-navy-900 hover:text-sky-500']}
                aria-current={current === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.phoneHref} class:list={['hidden shrink-0 items-center gap-2 rounded-full bg-lime-400 px-4 py-2 text-sm font-bold whitespace-nowrap text-navy-950 hover:bg-white sm:inline-flex']}>
        <Icon name="phone" class="size-4" />
        {site.phone}
      </a>
      <button
        type="button"
        class:list={['inline-flex size-11 items-center justify-center rounded-lg border lg:hidden', overlay ? 'border-white/30 text-white' : 'border-slate-200 text-navy-900']}
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-slate-200 bg-white lg:hidden" data-menu>
    <nav aria-label="Mobile" class="container-x py-4">
      <ul class="space-y-1">
        <li><a href="/" class="block rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">Home</a></li>
        <li><a href="/about-us/" class="block rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">About</a></li>
        <li><a href="/our-services/" class="block rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">Services</a></li>
        {
          groups.map((g) => (
            <li>
              <details class="group">
                <summary class:list={['flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-3 font-semibold hover:bg-sky-50', g.secondary ? 'text-base text-muted' : 'text-lg text-navy-900']}>
                  {g.name}
                  <Icon name="chevronDown" class="size-5 transition group-open:rotate-180" />
                </summary>
                <ul class="mb-2 ml-3 border-l-2 border-sky-100 pl-3">
                  {g.links.map((c) => (
                    <li>
                      <a href={c.href} class="block rounded-lg px-3 py-2.5 text-ink hover:bg-sky-50">
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
        <li>
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">
              Service Areas
              <Icon name="chevronDown" class="size-5 transition group-open:rotate-180" />
            </summary>
            <div class="mb-2 ml-3 space-y-3 border-l-2 border-sky-100 pl-3">
              {
                locationGroups.map((r) => (
                  <div>
                    <p class="px-3 pt-1 text-xs font-bold tracking-wider text-muted uppercase">{r.name}</p>
                    <ul class="grid grid-cols-2">
                      {r.links.map((c) => (
                        <li>
                          <a href={c.href} class="block rounded-lg px-3 py-2 text-ink hover:bg-sky-50">
                            {c.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
              <a href="/service-areas/" class="block rounded-lg px-3 py-2 font-semibold text-navy-700 hover:bg-sky-50">All Service Areas</a>
            </div>
          </details>
        </li>
        <li><a href="/blog/" class="block rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">Blog</a></li>
        <li><a href="/contact-us/" class="block rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">Contact</a></li>
      </ul>
      <a href={site.phoneHref} class="btn-primary mt-4 w-full">
        <Icon name="phone" class="size-5" />
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
