---
import Icon from './Icon.astro';
import GoogleMap from './GoogleMap.astro';
import { site, mainLocation, type Location } from '../data/site';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const isMain = location.slug === mainLocation.slug;
const query = encodeURIComponent(`${location.city}, FL`);
---

<section class="section relative isolate overflow-hidden bg-navy-950 text-white">
  <div class="drift pointer-events-none absolute -top-48 -left-40 -z-10 size-[34rem] rounded-full bg-sky-500/20 blur-[120px]"></div>
  <div class="drift pointer-events-none absolute -right-32 -bottom-56 -z-10 size-[30rem] rounded-full bg-lime-500/15 blur-[120px] [animation-delay:-7s]"></div>

  <div class="container-x relative grid gap-12 lg:grid-cols-5">
    <div class="lg:col-span-2" data-reveal="left">
      <p class="eyebrow !text-lime-400">Service area</p>
      <h2 class="text-[2rem] leading-[1.1] !text-white sm:text-[2.6rem]">Where we work in {location.city}</h2>
      <p class="mt-4 text-lg text-white/70">
        Air duct, AC ductwork and HVAC cleaning for homes, condos and businesses in {location.city} and surrounding {location.county} communities.
      </p>

      <a
        href={site.phoneHref}
        class="group mt-8 flex items-center gap-4 rounded-2xl bg-white/[0.06] p-4 ring-1 ring-white/10 backdrop-blur transition duration-300 hover:-translate-y-0.5 hover:bg-white/10 hover:ring-white/20"
      >
        <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-lime-400 text-navy-950 transition duration-500 group-hover:-rotate-6">
          <Icon name="phone" />
        </span>
        <span>
          <span class="block text-sm font-semibold text-white/60">Call to schedule</span>
          <span class="block font-display text-xl font-bold text-white">{site.phone}</span>
        </span>
        <Icon name="arrowRight" class="ml-auto size-5 text-lime-400 transition group-hover:translate-x-1" />
      </a>

      <div class="mt-8">
        <p class="font-bold text-white">Neighborhoods we serve</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            location.neighborhoods.map((n) => (
              <li class="rounded-full bg-white/[0.06] px-3 py-1.5 text-sm font-medium text-white/85 ring-1 ring-white/10">{n}</li>
            ))
          }
        </ul>
      </div>
      {
        location.nearby.length > 0 && (
          <div class="mt-6">
            <p class="font-bold text-white">Also nearby</p>
            <p class="mt-2 text-white/60">{location.nearby.join(', ')}</p>
          </div>
        )
      }
    </div>

    <div class="lg:col-span-3" data-reveal="right">
      {
        isMain ? (
          <GoogleMap dark class="h-[380px] lg:h-full lg:min-h-[440px]" />
        ) : (
          <div class="h-full min-h-[380px] overflow-hidden rounded-[1.75rem] bg-white/[0.06] p-1.5 ring-1 ring-white/10 backdrop-blur">
            <iframe
              title={`Map of ${location.city}, FL`}
              src={`https://www.google.com/maps?q=${query}&output=embed`}
              class="h-full min-h-[380px] w-full rounded-[1.4rem] border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        )
      }
    </div>
  </div>
</section>
