---
import Icon from './Icon.astro';
import { site, locations, type Location } from '../data/site';

interface Props {
  location: Location;
}

const { location } = Astro.props;

// Link nearby cities to their own location pages when one exists, for internal linking.
const nearby = location.nearby.map((name) => {
  const match = locations.find((l) => l.city === name);
  return { name, path: match?.path };
});
---

<section class="section bg-surface">
  <div class="container-x grid gap-10 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Service area</p>
      <h2 class="text-3xl sm:text-4xl">Where we work in {location.city}</h2>
      <p class="mt-4 text-lg text-muted">
        Air duct, HVAC, and dryer vent cleaning for homes, condos, and businesses in {location.city} and nearby {location.county} communities.
      </p>
      <a href={site.phoneHref} class="btn-primary mt-6">
        <Icon name="phone" class="size-5" />
        {site.phone}
      </a>
    </div>
    <div>
      <p class="font-bold text-navy-900">Neighborhoods we serve</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          location.neighborhoods.map((n) => (
            <li class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-navy-900">{n}</li>
          ))
        }
      </ul>
      {
        nearby.length > 0 && (
          <p class="mt-6 text-muted">
            <span class="font-semibold text-navy-900">Also nearby: </span>
            {nearby.map((n, i) => (
              <>
                {i > 0 && ', '}
                {n.path ? (
                  <a href={n.path} class="font-medium text-navy-900 underline decoration-slate-300 underline-offset-4 hover:text-sky-600">
                    {n.name}
                  </a>
                ) : (
                  n.name
                )}
              </>
            ))}
          </p>
        )
      }
    </div>
  </div>
</section>
