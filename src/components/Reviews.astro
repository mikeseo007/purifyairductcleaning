---
import Icon from './Icon.astro';
import GoogleReviewCard from './GoogleReviewCard.astro';
import { site } from '../data/site';
import { getLiveReviews } from '../data/live-reviews';

interface Props {
  title?: string;
  eyebrow?: string;
  limit?: number;
  tint?: boolean;
}

const { title = 'Trusted by Homeowners and Businesses in Aventura' } = Astro.props;
const liveReviews = await getLiveReviews();
const reviews = liveReviews && liveReviews.reviews.length >= 5 ? liveReviews.reviews : [];
const { reviewsUrl, rating: fallbackRating, reviewCount: fallbackCount } = site.google;
const rating = liveReviews?.rating ?? fallbackRating;
const reviewCount = liveReviews?.reviewCount ?? fallbackCount;
---

{
  reviews.length >= 5 && (
    <section class="bg-white py-14" id="reviews" data-home-reviews>
      <div class="container-x">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-[11px] font-bold tracking-[0.16em] text-sky-500 uppercase">Our customers</p>
            <h2 class="mt-2 text-2xl leading-tight">{title}</h2>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex gap-2">
              <button type="button" class="flex size-10 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-900 shadow-sm hover:bg-sky-50" aria-label="Previous reviews" data-reviews-prev>
                <Icon name="chevronRight" class="size-5 rotate-180" />
              </button>
              <button type="button" class="flex size-10 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-900 shadow-sm hover:bg-sky-50" aria-label="Next reviews" data-reviews-next>
                <Icon name="chevronRight" class="size-5" />
              </button>
            </div>
            <a href={reviewsUrl} class="text-sm font-bold text-sky-600" target="_blank" rel="noopener">
              {rating.toFixed(1)} from {reviewCount} Google reviews
            </a>
          </div>
        </div>
        <ul class="mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-reviews-track aria-label="Google reviews">
          {reviews.map((review) => (
            <li class="w-full shrink-0 snap-start sm:w-[calc(50%-6px)] xl:w-[calc(33.333%-8px)]">
              <GoogleReviewCard name={review.name} text={review.text} rating={review.rating} date={review.date} meta={review.meta} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-home-reviews]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const track = root.querySelector<HTMLElement>('[data-reviews-track]');
    if (!track) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const distance = () => {
      const card = track.children[0] as HTMLElement | undefined;
      if (!card) return track.clientWidth;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 12;
      return card.offsetWidth + gap;
    };
    const move = (direction: number) => {
      const max = track.scrollWidth - track.clientWidth;
      if (max <= 4) return;
      const next = track.scrollLeft + direction * distance();
      if (direction > 0 && next >= max - 4) {
        track.scrollTo({ left: 0, behavior: reduce ? 'auto' : 'smooth' });
        return;
      }
      if (direction < 0 && track.scrollLeft <= 4) {
        track.scrollTo({ left: max, behavior: reduce ? 'auto' : 'smooth' });
        return;
      }
      track.scrollBy({ left: direction * distance(), behavior: reduce ? 'auto' : 'smooth' });
    };
    root.querySelector('[data-reviews-prev]')?.addEventListener('click', () => move(-1));
    root.querySelector('[data-reviews-next]')?.addEventListener('click', () => move(1));
  });
</script>
