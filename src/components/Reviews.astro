---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { reviews, site } from '../data/site';

interface Props {
  title?: string;
  eyebrow?: string;
  limit?: number;
  tint?: boolean;
}

const { title = 'What Our Customers Say on Google', eyebrow = 'Google reviews', limit = reviews.length, tint = false } = Astro.props;
const list = reviews.slice(0, limit);
const { rating, reviewCount, reviewsUrl } = site.google;

const avatarColors = ['bg-[#1a73e8]', 'bg-[#e8710a]', 'bg-[#188038]', 'bg-[#a142f4]', 'bg-[#d93025]', 'bg-[#12a4af]'];
const avatarColor = (name: string) => avatarColors[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % avatarColors.length];
const fmtDate = (ym: string) => new Date(`${ym}-15T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const stars = Array.from({ length: 5 });
---

<section class:list={['section relative overflow-hidden', tint ? 'bg-surface' : 'bg-white']} data-reviews>
  <div class="container-x relative">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <SectionHeading eyebrow={eyebrow} title={title} />

      <div class="card flex w-full flex-col gap-4 p-5 sm:w-auto sm:flex-row sm:items-center sm:gap-6" data-reveal="right">
        <div class="flex items-center gap-4">
          <svg viewBox="0 0 48 48" class="size-11 shrink-0" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z" />
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
          </svg>
          <div>
            <p class="text-sm font-semibold text-muted">Google Rating</p>
            <p class="flex items-center gap-2">
              <span class="text-3xl leading-none font-extrabold text-navy-900">{rating.toFixed(1)}</span>
              <span class="flex text-[#FBBC04]" aria-label={`${rating.toFixed(1)} out of 5 stars`}>
                {stars.map(() => <Icon name="star" class="size-5" />)}
              </span>
            </p>
            <a href={reviewsUrl} target="_blank" rel="noopener" class="text-sm text-muted underline-offset-2 hover:text-navy-700 hover:underline">
              Based on {reviewCount} reviews
            </a>
          </div>
        </div>
        <a href={reviewsUrl} target="_blank" rel="noopener" class="btn-navy !px-5 !py-2.5 text-sm"> Review us on Google </a>
      </div>
    </div>

    {list.length > 0 && (
    <div class="relative mt-10">
      <ul class="-mx-1 -my-6 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-1 py-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-reviews-track data-stagger>
        {
          list.map((r) => (
            <li class="w-[86%] shrink-0 snap-start sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] xl:w-[calc(25%-15px)]">
              <article class="card card-hover flex h-full flex-col p-6">
                <header class="flex items-start gap-3">
                  <span class:list={['flex size-11 shrink-0 items-center justify-center rounded-full text-lg font-bold text-white', avatarColor(r.name)]}>
                    {r.name.charAt(0).toUpperCase()}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate font-bold text-navy-900">{r.name}</p>
                    {r.meta && <p class="truncate text-xs text-muted">{r.meta}</p>}
                  </div>
                  <Icon name="google" class="size-5 shrink-0 text-[#4285F4]" title="Posted on Google" />
                </header>

                <div class="mt-4 flex items-center gap-2">
                  <span class="flex text-[#FBBC04]" aria-label={`${r.rating} out of 5 stars`}>
                    {stars.map((_, i) => <Icon name="star" class:list={['size-4', i >= r.rating && 'text-slate-200']} />)}
                  </span>
                  <span class="text-xs text-muted">{fmtDate(r.date)}</span>
                </div>

                <blockquote class="mt-3 line-clamp-5 leading-relaxed whitespace-pre-line text-ink" data-review-text>
                  {r.text}
                </blockquote>
                <button type="button" class="mt-1 hidden self-start text-sm font-semibold text-sky-600 hover:underline" data-review-more>
                  Read more
                </button>

                {r.services && (
                  <p class="mt-3 text-xs text-muted">
                    <span class="font-semibold text-ink">Services:</span> {r.services}
                  </p>
                )}

                <div class="mt-auto pt-4">
                  {r.ownerReply && (
                    <details class="group rounded-2xl bg-slate-50 px-4 py-3 text-sm">
                      <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-navy-800">
                        Response from the owner
                        <Icon name="chevronDown" class="size-4 transition group-open:rotate-180" />
                      </summary>
                      <p class="mt-2 leading-relaxed text-muted">{r.ownerReply}</p>
                    </details>
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="mt-4 hidden items-center justify-center gap-3" data-reviews-nav>
        <button type="button" class="flex size-11 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-800 shadow-sm hover:bg-sky-50" aria-label="Previous reviews" data-reviews-prev>
          <Icon name="chevronRight" class="size-5 rotate-180" />
        </button>
        <button type="button" class="flex size-11 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-800 shadow-sm hover:bg-sky-50" aria-label="Next reviews" data-reviews-next>
          <Icon name="chevronRight" class="size-5" />
        </button>
      </div>
    </div>
    )}

    <p class="mt-6 text-center">
      <a href={reviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-bold text-navy-700 hover:text-sky-500">
        Read all reviews on Google <Icon name="arrowRight" class="size-4" />
      </a>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    root.querySelectorAll<HTMLElement>('[data-review-text]').forEach((text) => {
      const more = text.nextElementSibling as HTMLButtonElement | null;
      if (!more || text.scrollHeight <= text.clientHeight + 1) return;
      more.classList.remove('hidden');
      more.addEventListener('click', () => {
        const expanded = text.classList.toggle('line-clamp-5') === false;
        more.textContent = expanded ? 'Show less' : 'Read more';
      });
    });

    const track = root.querySelector<HTMLElement>('[data-reviews-track]');
    const nav = root.querySelector<HTMLElement>('[data-reviews-nav]');
    if (!track || !nav) return;
    const update = () => {
      const overflowing = track.scrollWidth > track.clientWidth + 1;
      nav.classList.toggle('hidden', !overflowing);
      nav.classList.toggle('flex', overflowing);
    };
    const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
    root.querySelector('[data-reviews-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step() }));
    root.querySelector('[data-reviews-next]')?.addEventListener('click', () => track.scrollBy({ left: step() }));
    update();
    window.addEventListener('resize', update);
  });
</script>
