---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/images/purify-mark.png';
import { site, regions, locationsByRegion } from '../data/site';
import { serviceGroups, servicesByGroup } from '../data/services';

const socials = [
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
  { name: 'tiktok', href: site.social.tiktok, label: 'TikTok' },
  { name: 'pinterest', href: site.social.pinterest, label: 'Pinterest' },
  { name: 'x', href: site.social.x, label: 'X (Twitter)' },
].filter((s) => s.href);

const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden bg-navy-950 text-white/70">
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-sky-500/15 blur-[120px]"></div>
  <div class="h-px bg-gradient-to-r from-transparent via-sky-400/50 to-transparent"></div>
  <div class="container-x grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <a href="/" class="inline-flex max-w-full items-center gap-3 rounded-2xl bg-white py-3 pr-4 pl-3 sm:gap-4 sm:pr-5 sm:pl-4" aria-label={`${site.name} home`}>
        <Image src={logo} alt="Purify Air Duct Cleaning logo" title="Purify Air Duct Cleaning" format="webp" width={144} densities={[1, 2]} class="h-14 w-auto shrink-0 sm:h-16" />
        <span class="border-l-2 border-slate-200 pl-4 font-display text-[0.9rem] leading-[1.15] font-bold tracking-[0.06em] text-navy-900 uppercase">
          Air Duct &amp;<br /><span class="text-navy-700">Dryer Vent Cleaning</span>
        </span>
      </a>
      <address class="mt-6 space-y-3 not-italic">
        <p class="font-bold text-white">{site.name}</p>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="flex items-start gap-2.5 hover:text-white">
          <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-sky-400" />
          <span>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</span>
        </a>
        <a href={site.phoneHref} class="flex items-center gap-2.5 font-bold text-white hover:text-lime-500">
          <Icon name="phone" class="size-5 shrink-0 text-sky-400" />
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-2.5 hover:text-white">
          <Icon name="mail" class="size-5 shrink-0 text-sky-400" />
          {site.email}
        </a>
        <p class="flex items-start gap-2.5">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-sky-400" />
          <span>{site.hours.long}</span>
        </p>
      </address>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={`${site.shortName} on ${s.label}`}
                class="flex size-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-sky-500 hover:text-white"
              >
                <Icon name={s.name} class="size-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 lg:col-span-5">
      {
        serviceGroups.map((g) => (
          <div>
            <h2 class="text-base font-bold text-white">
              <a href={g.hub} class="hover:text-lime-500">{g.name}</a>
            </h2>
            <ul class="mt-4 space-y-2.5">
              {servicesByGroup(g.id).map((s) => (
                <li>
                  <a href={s.path} class="hover:text-lime-500">
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-base font-bold text-white">Company</h2>
      <ul class="mt-4 space-y-2.5">
        <li><a href="/about-us/" class="hover:text-lime-500">About Us</a></li>
        <li><a href="/our-services/" class="hover:text-lime-500">All Services</a></li>
        <li><a href="/service-areas/" class="hover:text-lime-500">Service Areas</a></li>
        <li><a href="/blog/" class="hover:text-lime-500">Blog</a></li>
        <li><a href="/contact-us/" class="hover:text-lime-500">Contact Us</a></li>
      </ul>
    </div>

    <div class="border-t border-white/10 pt-10 lg:col-span-12">
      <h2 class="text-base font-bold text-white">
        <a href="/service-areas/" class="hover:text-lime-500">Service Areas</a>
      </h2>
      <div class="mt-4 grid gap-6 md:grid-cols-3">
        {
          regions.map((r) => (
            <div>
              <h3 class="text-xs font-bold tracking-wider text-white/50 uppercase">{r.name}</h3>
              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                {locationsByRegion(r.id).map((l) => (
                  <li>
                    <a href={l.path} class="hover:text-lime-500">{l.city}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
        <span class="mx-2 text-white/30">|</span>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
