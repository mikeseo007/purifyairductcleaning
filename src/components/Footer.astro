---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, regions, locationsByRegion } from '../data/site';
import { services } from '../data/services';

const year = new Date().getFullYear();
const featured = ['air-duct-cleaning', 'dryer-vent-cleaning', 'hvac-cleaning', 'air-duct-sanitizing', 'ac-duct-replacement', 'attic-insulation-removal']
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s) => s !== undefined);
---

<footer class="bg-navy-950 text-white/70">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-12 lg:py-16">
    <div class="sm:col-span-2 lg:col-span-3">
      <a href="/" aria-label={`${site.name} home`}>
        <Logo tone="light" />
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed">Professional air duct, HVAC, and dryer vent cleaning for homes and businesses in Aventura and nearby South Florida.</p>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-bold tracking-wide text-white uppercase">Quick Links</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/" class="hover:text-white">Home</a></li>
        <li><a href="/about-us/" class="hover:text-white">About</a></li>
        <li><a href="/our-services/" class="hover:text-white">Services</a></li>
        <li><a href="/service-areas/" class="hover:text-white">Service Areas</a></li>
        <li><a href="/blog/" class="hover:text-white">Blog</a></li>
        <li><a href="/contact-us/" class="hover:text-white">Contact</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-bold tracking-wide text-white uppercase">Our Services</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {featured.map((s) => (
          <li><a href={s.path} class="hover:text-white">{s.name}</a></li>
        ))}
        <li><a href="/our-services/" class="font-semibold text-white hover:text-sky-300">View all services</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-sm font-bold tracking-wide text-white uppercase">Service Areas</h2>
      <div class="mt-4 space-y-4">
        {
          regions.map((r) => (
            <div>
              <h3 class="text-xs font-bold tracking-wider text-white/45 uppercase">{r.name}</h3>
              <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1.5 text-sm">
                {locationsByRegion(r.id).map((l) => (
                  <li><a href={l.path} class="hover:text-white">{l.city}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-bold tracking-wide text-white uppercase">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={site.phoneHref} class="flex items-start gap-2 font-semibold text-white hover:text-sky-300">
            <Icon name="phone" class="mt-0.5 size-4 shrink-0" />
            {site.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="flex items-start gap-2 hover:text-white">
            <Icon name="mail" class="mt-0.5 size-4 shrink-0" />
            {site.email}
          </a>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0" />
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="hover:text-white">
            {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}
          </a>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="clock" class="mt-0.5 size-4 shrink-0" />
          <span>{site.hours.long}</span>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-5 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
        <span class="mx-2 text-white/30">|</span>
        <a href="/terms-and-conditions/" class="hover:text-white">Terms &amp; Conditions</a>
        <span class="mx-2 text-white/30">|</span>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
