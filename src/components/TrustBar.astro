---
import Icon from './Icon.astro';
import { site, locations } from '../data/site';
import { services } from '../data/services';

const { rating, reviewCount } = site.google;

const stats = [
  { value: rating.toFixed(1), suffix: '', icon: 'star', label: 'Google rating', text: `From ${reviewCount} customer reviews` },
  { value: '24', suffix: 'h', icon: 'clock', label: 'Open every day', text: 'Including weekends' },
  { value: String(services.length), suffix: '', icon: 'hvac', label: 'Specialized services', text: 'Ducts, HVAC and dryer vents' },
  { value: String(locations.length), suffix: '', icon: 'pin', label: 'Cities served', text: 'Miami-Dade, Broward and Boca Raton' },
];
---

<section class="relative z-10 -mt-20 lg:-mt-24">
  <div class="container-x">
    <ul class="grid grid-cols-2 overflow-hidden rounded-[2rem] bg-white shadow-[0_30px_80px_-30px_rgb(7_19_48/0.45)] ring-1 ring-slate-200/70 lg:grid-cols-4" data-stagger>
      {
        stats.map((s, i) => (
          <li class:list={['group relative p-5 sm:p-7', i % 2 === 1 && 'border-l border-slate-100', i > 1 && 'border-t border-slate-100 lg:border-t-0', i === 2 && 'lg:border-l']}>
            <div class="flex items-center justify-between">
              <p class="font-display text-4xl leading-none font-bold tracking-tight text-navy-900 sm:text-5xl">
                <span data-count={s.value}>{s.value}</span>
                <span class="text-sky-500">{s.suffix}</span>
              </p>
              <span class="flex size-10 items-center justify-center rounded-xl bg-sky-50 text-sky-500 transition duration-500 group-hover:rotate-6 group-hover:bg-navy-900 group-hover:text-lime-500">
                <Icon name={s.icon} class="size-5" />
              </span>
            </div>
            <p class="mt-3 font-bold text-balance text-navy-900">{s.label}</p>
            <p class="mt-0.5 hidden text-sm text-muted sm:block">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
