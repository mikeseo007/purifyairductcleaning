---
import { site, locations } from '../data/site';
import { services } from '../data/services';

const { rating, reviewCount } = site.google;

const stats = [
  { value: rating.toFixed(1), suffix: '', label: 'Google rating', text: `From ${reviewCount} reviews` },
  { value: '24', suffix: '/7', label: 'Open every day', text: 'Including weekends' },
  { value: String(services.length), suffix: '', label: 'Services', text: 'Ducts, HVAC, and dryer vents' },
  { value: String(locations.length), suffix: '', label: 'Cities served', text: 'Miami-Dade, Broward, and Boca Raton' },
];
---

<section class="border-b border-slate-100 bg-white">
  <div class="container-x">
    <ul class="grid grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s, i) => (
          <li class:list={['px-2 py-8 sm:px-6', i > 0 && 'lg:border-l lg:border-slate-100', i % 2 === 1 && 'border-l border-slate-100 lg:border-l', i > 1 && 'border-t border-slate-100 lg:border-t-0']}>
            <p class="font-display text-3xl font-bold text-navy-900 sm:text-4xl">
              {s.value}<span class="text-sky-500">{s.suffix}</span>
            </p>
            <p class="mt-2 font-semibold text-navy-900">{s.label}</p>
            <p class="mt-1 text-sm text-muted">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
