---
import Icon from './Icon.astro';

interface Props {
  items: { name: string; path: string }[];
  dark?: boolean;
}

const { items, dark = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-5">
  <ol class:list={['flex flex-wrap items-center gap-1.5 text-sm', dark ? 'text-white/65' : 'text-muted']}>
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <Icon name="chevronRight" class="size-3.5 opacity-60" />}
          {i < items.length - 1 ? (
            <a href={item.path} class:list={['hover:underline', dark ? 'hover:text-white' : 'hover:text-navy-700']}>
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class={dark ? 'text-white' : 'text-ink'}>
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
