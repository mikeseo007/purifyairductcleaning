---
import Icon from './Icon.astro';
import { regions, locationsByRegion, type Location } from '../data/site';
import { serviceGroups, servicesByGroup } from '../data/services';

interface Props {
  location?: Location;
  service?: string;
  heading?: string;
  id?: string;
  compact?: boolean;
}

const { location, service, heading = 'Request a Free Quote', id = 'quote', compact = false } = Astro.props;
const cols = compact ? 'grid gap-4' : 'grid gap-4 @min-[34rem]:grid-cols-2';
const field =
  'w-full min-w-0 rounded-2xl border border-slate-200 bg-surface px-4 py-3.5 text-base text-ink placeholder:text-slate-400 transition duration-300 hover:border-slate-300 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-500/15 focus:outline-none';
---

<div id={id} class="@container relative scroll-mt-28 overflow-hidden rounded-[calc(2rem-1px)] bg-white p-6 shadow-2xl shadow-navy-950/25 sm:p-8">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-500 via-sky-400 to-lime-500"></div>
  <div>
    <p class="font-display text-[1.65rem] leading-tight font-bold tracking-tight text-navy-900">{heading}</p>
    <p class="mt-1.5 text-muted">Tell us about your AC system or vent and we’ll get back to you to schedule.</p>
  </div>

  <form name="service-request" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company" class="mt-6 grid gap-4">
    <input type="hidden" name="form-name" value="service-request" />
    <p class="hidden">
      <label>Leave this field empty <input name="company" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class={cols}>
      <label class="block min-w-0">
        <span class="sr-only">Full name</span>
        <input class={field} type="text" name="name" placeholder="Full name *" autocomplete="name" required />
      </label>
      <label class="block min-w-0">
        <span class="sr-only">Phone number</span>
        <input
          class={field}
          type="tel"
          name="phone"
          placeholder="Phone number *"
          autocomplete="tel"
          inputmode="tel"
          pattern="[0-9()+\-.\s]{10,}"
          title="Please enter a valid phone number"
          required
        />
      </label>
    </div>

    <label class="block min-w-0">
      <span class="sr-only">Service address or ZIP code</span>
      <input class={field} type="text" name="address" placeholder="Service address or ZIP code" autocomplete="street-address" />
    </label>

    <div class={cols}>
      <label class="block min-w-0">
        <span class="sr-only">Service needed</span>
        <select class={field} name="service">
          <option value="">Service needed</option>
          {
            serviceGroups.map((g) => (
              <optgroup label={g.name}>
                {servicesByGroup(g.id).map((s) => (
                  <option value={s.name} selected={s.name === service}>
                    {s.name}
                  </option>
                ))}
              </optgroup>
            ))
          }
          <option value="Not sure">Not sure, please advise</option>
        </select>
      </label>
      <label class="block min-w-0">
        <span class="sr-only">Service area</span>
        <select class={field} name="location">
          <option value="">Service area</option>
          {
            regions.map((r) => (
              <optgroup label={r.name}>
                {locationsByRegion(r.id).map((l) => (
                  <option value={l.city} selected={l.slug === location?.slug}>
                    {l.city}
                  </option>
                ))}
              </optgroup>
            ))
          }
          <option value="Other">Other area</option>
        </select>
      </label>
    </div>

    <label class="block min-w-0">
      <span class="sr-only">Message</span>
      <textarea class={field} name="message" rows="3" placeholder="How can we help?"></textarea>
    </label>

    <button type="submit" class="btn-primary w-full !py-4 text-lg">
      Send Service Request
      <Icon name="arrowRight" class="size-5" />
    </button>
    <p class="text-center text-xs text-muted">We respect your privacy. Your details are only used to respond to your request.</p>
  </form>
</div>
