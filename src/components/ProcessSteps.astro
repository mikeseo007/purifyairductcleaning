---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  eyebrow?: string;
  bg?: 'surface' | 'white';
  steps?: { title: string; text: string; icon?: string }[];
}

const defaultSteps = [
  {
    title: 'Inspection',
    text: 'We inspect your system to identify buildup, debris, and problem areas.',
  },
  {
    title: 'Cleaning',
    text: 'Using advanced equipment, we remove dust, dirt, and contaminants.',
  },
  {
    title: 'Sanitizing',
    text: 'Optional disinfection to help reduce bacteria, mold, and odors.',
  },
  {
    title: 'Cleaner Air',
    text: 'Enjoy a healthier home and improved HVAC efficiency.',
  },
];

const icons = ['search', 'duct', 'sanitize', 'wind'];
const { title = 'How Our Air Duct Cleaning Works', eyebrow = 'Our Process', bg = 'surface', steps = defaultSteps } = Astro.props;
---

<section id="how-it-works" class:list={['section', bg === 'white' ? 'bg-white' : 'bg-surface']}>
  <div class="container-x">
    <SectionHeading eyebrow={eyebrow} title={title} center />
    <ol class="relative mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="relative text-center">
            {
              i < steps.length - 1 && (
                <span
                  aria-hidden="true"
                  class:list={[
                    'pointer-events-none absolute top-7 left-[calc(50%+1.75rem)] z-0 h-0.5 w-[calc(100%-1.5rem)] bg-navy-900/15',
                    i % 2 === 1 ? 'hidden lg:block' : 'hidden sm:block',
                  ]}
                />
              )
            }
            <span class="relative z-10 mx-auto flex size-14 items-center justify-center rounded-2xl bg-navy-900 text-lime-400">
              <Icon name={s.icon ?? icons[i] ?? 'check'} class="size-6" />
            </span>
            <p class="mt-4 text-xs font-bold tracking-[0.16em] text-sky-500">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-1 font-display text-xl">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
