---
import AirStream from './AirStream.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  breadcrumbs: { name: string; path: string }[];
  overlap?: boolean;
}

const { eyebrow, title, subtitle, breadcrumbs, overlap = false } = Astro.props;
---

<section class:list={['relative isolate overflow-hidden bg-navy-950', overlap ? 'pb-36 lg:pb-44' : 'pb-16 sm:pb-24']}>
  <div class="drift pointer-events-none absolute -top-48 -right-40 -z-10 size-[36rem] rounded-full bg-sky-500/25 blur-[120px]"></div>
  <div class="drift pointer-events-none absolute -bottom-56 left-0 -z-10 size-[28rem] rounded-full bg-lime-500/15 blur-[110px] [animation-delay:-6s]"></div>
  <AirStream class="absolute top-16 right-[-4rem] -z-10 hidden w-[34rem] opacity-45 md:block lg:right-[2%] lg:w-[40rem]" />

  <div class="container-x relative pt-12 sm:pt-16 lg:pt-20">
    <div class="rise" style="--d:0"><Breadcrumbs items={breadcrumbs} dark /></div>
    {eyebrow && <p class="eyebrow rise !text-lime-500" style="--d:1">{eyebrow}</p>}
    <h1 class="rise-text max-w-4xl text-[2.25rem] leading-[1.06] !text-white sm:text-5xl lg:text-6xl xl:text-[4rem]">{title}</h1>
    {subtitle && <p class="rise mt-6 max-w-3xl text-lg leading-relaxed text-white/75 sm:text-xl" style="--d:2">{subtitle}</p>}
  </div>
</section>
