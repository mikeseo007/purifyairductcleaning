---
import Breadcrumbs from './Breadcrumbs.astro';
import HeroBackdrop from './HeroBackdrop.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  breadcrumbs: { name: string; path: string }[];
  overlap?: boolean;
}

const { eyebrow, title, subtitle, breadcrumbs } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy-950">
  <HeroBackdrop />
  <div class="container-x relative py-14 sm:py-16 lg:py-20">
    <Breadcrumbs items={breadcrumbs} dark />
    {eyebrow && <p class="eyebrow !text-lime-400">{eyebrow}</p>}
    <h1 class="max-w-4xl text-[2.4rem] leading-[1.05] font-extrabold !text-white sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-white/75">{subtitle}</p>}
  </div>
</section>
