---
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="section relative isolate overflow-hidden bg-navy-950">
  <div class="pointer-events-none absolute top-1/2 -left-40 -z-10 size-[32rem] -translate-y-1/2 rounded-full bg-sky-500/20 blur-[120px]"></div>
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-reveal>
      <p class="eyebrow !text-lime-500">{eyebrow}</p>
      <h2 class="text-4xl !text-white sm:text-5xl">{title}</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/75">{text}</p>
      <a href={site.phoneHref} class="group mt-8 inline-flex items-center gap-4 rounded-2xl bg-white/5 p-3 pr-6 ring-1 ring-white/10 transition hover:bg-white/10">
        <span class="flex size-12 items-center justify-center rounded-xl bg-lime-500 text-navy-950"><Icon name="phone" class="size-5" /></span>
        <span>
          <span class="block text-sm text-white/60">Prefer to talk? Call us</span>
          <span class="font-display text-xl font-bold text-white">{site.phone}</span>
        </span>
      </a>
    </div>
    <div data-reveal="right" class="rounded-[2rem] bg-gradient-to-br from-white/40 via-white/10 to-white/30 p-px">
      <QuoteForm />
    </div>
  </div>
</section>
