---
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="section bg-white">
  <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="text-3xl sm:text-4xl">{title}</h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{text}</p>
      <a href={site.phoneHref} class="mt-8 inline-flex items-center gap-3 font-bold text-navy-900 hover:text-sky-500">
        <span class="icon-chip size-11"><Icon name="phone" class="size-5" /></span>
        {site.phone}
      </a>
    </div>
    <QuoteForm />
  </div>
</section>
