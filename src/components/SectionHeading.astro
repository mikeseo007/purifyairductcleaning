---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
  dark?: boolean;
  as?: 'h2' | 'h3';
}

const { eyebrow, title, intro, center = false, dark = false, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class:list={['eyebrow', dark && '!text-lime-500']}>{eyebrow}</p>}
  <Tag class:list={['text-[2rem] leading-[1.08] sm:text-4xl lg:text-[2.75rem]', dark && '!text-white']}>{title}</Tag>
  {intro && <p class:list={['mt-4 max-w-2xl text-base leading-relaxed sm:text-lg', dark ? 'text-white/70' : 'text-muted', center && 'mx-auto']}>{intro}</p>}
</div>
