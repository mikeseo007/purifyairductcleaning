---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photos } from '../data/photos';

const items = [
  { href: '/hvac-cleaning/', icon: 'hvac', title: 'HVAC Cleaning', text: 'Coil, blower, drain pan, cabinet and plenums cleaned as one system.' },
  { href: '/ac-coil-cleaning/', icon: 'coil', title: 'AC Coil Cleaning', text: 'Clears the dust mat on the evaporator coil that restricts airflow.' },
  { href: '/hvac-mold-cleaning/', icon: 'droplet', title: 'HVAC Mold Cleaning', text: 'Cleaning for musty odors and suspected microbial buildup on wet AC components.' },
];
---

<section class="section relative isolate overflow-hidden bg-navy-950 text-white">
  <div class="drift pointer-events-none absolute -top-40 -left-40 -z-10 size-[34rem] rounded-full bg-sky-500/20 blur-[120px]"></div>
  <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div>
      <div data-reveal>
        <p class="eyebrow !text-lime-500">Inside your AC system</p>
        <h2 class="text-[2.1rem] leading-[1.08] !text-white sm:text-5xl">
          Musty smell or weak airflow? <span class="text-gradient">Look past the ducts.</span>
        </h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-white/75">
          <p>
            In Aventura’s humidity, the evaporator coil, drain pan and air handler stay wet much of the year. Dust that reaches those surfaces sticks, and it’s a common source of
            musty AC odors and reduced airflow.
          </p>
          <p class="text-base text-white/55">
            Not every dirty vent means mold, and mold can’t be confirmed by looking. We don’t test for mold. We clean the HVAC components and accessible ductwork where
            buildup collects.
          </p>
        </div>
      </div>
      <ul class="mt-9 space-y-3" data-stagger>
        {
          items.map((i) => (
            <li>
              <a href={i.href} class="spotlight group flex items-start gap-4 rounded-2xl bg-white/[0.04] p-4 ring-1 ring-white/10 transition duration-300 hover:bg-white/[0.08] hover:ring-white/20">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-sky-400 to-sky-600 text-white shadow-lg shadow-sky-500/30 transition duration-500 group-hover:-rotate-6">
                  <Icon name={i.icon} class="size-5" />
                </span>
                <span class="flex-1">
                  <span class="flex items-center gap-1.5 font-bold text-white group-hover:text-lime-400">
                    {i.title}
                    <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
                  </span>
                  <span class="mt-0.5 block text-white/65">{i.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="relative" data-reveal="zoom">
      <div class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-br from-sky-500/30 via-transparent to-lime-500/25 blur-2xl"></div>
      <div class="unmask overflow-hidden rounded-[1.75rem] ring-1 ring-white/15">
        <Image
          src={photos.acOutdoor.src}
          alt={photos.acOutdoor.alt}
          title={photos.acOutdoor.alt}
          format="webp"
          widths={[480, 760, 960, 1200, 1536]}
          sizes="(min-width: 1024px) 600px, 100vw"
          class="parallax aspect-[4/5] max-h-[640px] w-full object-cover"
        />
      </div>
      <div class="float-slow absolute -bottom-6 -left-4 rounded-2xl bg-white p-4 shadow-2xl shadow-black/40 sm:-left-8" aria-hidden="true">
        <p class="text-xs font-bold tracking-widest text-muted uppercase">What we clean</p>
        <ul class="mt-2 flex flex-wrap gap-1.5 text-sm font-semibold text-navy-900">
          {['Coil', 'Drain pan', 'Blower', 'Cabinet'].map((t) => <li class="rounded-full bg-sky-50 px-2.5 py-1 ring-1 ring-sky-100">{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
