---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photos } from '../data/photos';

const points = [
  { href: '/air-duct-cleaning/', title: 'Reduce allergens and dust' },
  { href: '/hvac-cleaning/', title: 'Improve airflow and efficiency' },
  { href: '/air-duct-sanitizing/', title: 'Create a healthier indoor environment' },
];
---

<section class="bg-navy-950 text-white">
  <div class="grid lg:grid-cols-2">
    <div class="px-5 py-14 sm:px-6 lg:py-20 lg:pr-16 lg:pl-[max(1.5rem,calc((100%-80rem)/2+2rem))]">
      <p class="text-xs font-bold tracking-[0.18em] text-sky-300 uppercase">Breathe the difference</p>
      <h2 class="mt-3 max-w-xl text-[1.85rem] leading-[1.15] !text-white sm:text-4xl">Dust, allergens and contaminants build up over time.</h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg">
        Professional cleaning removes what you can’t see and helps your system run more efficiently. Here is where you can breathe easier.
      </p>
      <ul class="mt-8 space-y-4">
        {
          points.map((item) => (
            <li>
              <a href={item.href} class="group inline-flex items-center gap-3 font-semibold text-white hover:text-sky-300">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-lime-400 text-navy-950">
                  <Icon name="check" class="size-3.5" />
                </span>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="relative grid min-h-72 grid-cols-2 lg:min-h-full">
      <Image
        src={photos.coilBefore.src}
        alt={photos.coilBefore.alt}
        title={photos.coilBefore.alt}
        format="webp"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 25vw, 50vw"
        class="h-full min-h-72 w-full object-cover lg:absolute lg:inset-y-0 lg:left-0 lg:w-1/2"
      />
      <Image
        src={photos.coilAfter.src}
        alt={photos.coilAfter.alt}
        title={photos.coilAfter.alt}
        format="webp"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 25vw, 50vw"
        class="h-full min-h-72 w-full object-cover lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2"
      />
      <span class="absolute bottom-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-navy-900">Before</span>
      <span class="absolute right-4 bottom-4 rounded-full bg-sky-500 px-3 py-1 text-xs font-bold text-white">After</span>
    </div>
  </div>
</section>
