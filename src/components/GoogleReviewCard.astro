---
interface Props {
  name: string;
  text: string;
  rating: number;
  date?: string;
  meta?: string;
  services?: string;
  ownerReply?: string;
}

const { name, text, rating, date, meta, services, ownerReply } = Astro.props;

const avatarColors = ['bg-[#1a73e8]', 'bg-[#ea4335]', 'bg-[#f9ab00]', 'bg-[#188038]', 'bg-[#9334e6]', 'bg-[#12a4af]'];
const avatarColor = avatarColors[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % avatarColors.length];
const when = date && /^\d{4}-\d{2}$/.test(date)
  ? new Date(`${date}-15T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : date;
const stars = Array.from({ length: 5 });
---

<article class="flex h-full flex-col rounded-lg border border-[#dadce0] bg-white p-4 shadow-[0_1px_2px_rgb(60_64_67/0.08)]">
  <header class="flex items-start gap-3">
    <span class:list={['flex size-10 shrink-0 items-center justify-center rounded-full text-base font-medium text-white', avatarColor]} aria-hidden="true">
      {name.charAt(0).toUpperCase()}
    </span>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-[#202124]">{name}</p>
      {meta && <p class="truncate text-xs text-[#70757a]">{meta}</p>}
    </div>
    <svg viewBox="0 0 48 48" class="size-5 shrink-0" aria-hidden="true">
      <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z" />
      <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
      <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
      <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
    </svg>
  </header>

  <div class="mt-3 flex items-center gap-2">
    <span class="flex gap-0.5" aria-label={`${rating} out of 5 stars`}>
      {
        stars.map((_, i) => (
          <svg viewBox="0 0 24 24" class:list={['size-3.5', i < rating ? 'text-[#FBBC04]' : 'text-[#e8eaed]']} aria-hidden="true">
            <path fill="currentColor" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8Z" />
          </svg>
        ))
      }
    </span>
    {when && <span class="text-xs text-[#70757a]">{when}</span>}
  </div>

  <p class="mt-2 line-clamp-5 text-sm leading-5 whitespace-pre-line text-[#3c4043]" data-review-text>{text}</p>
  <button type="button" class="mt-1 hidden self-start text-sm font-medium text-[#1a73e8] hover:underline" data-review-more>More</button>

  {services && (
    <p class="mt-3 text-xs text-[#70757a]">
      <span class="font-medium text-[#3c4043]">Services:</span> {services}
    </p>
  )}

  {ownerReply && (
    <details class="mt-auto pt-3">
      <summary class="cursor-pointer text-sm font-medium text-[#1a73e8]">Response from the owner</summary>
      <p class="mt-2 text-sm leading-5 text-[#3c4043]">{ownerReply}</p>
    </details>
  )}
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-review-text]').forEach((text) => {
    const more = text.nextElementSibling as HTMLButtonElement | null;
    if (!more?.hasAttribute('data-review-more') || more.dataset.bound === 'true') return;
    if (text.scrollHeight <= text.clientHeight + 1) return;
    more.dataset.bound = 'true';
    more.classList.remove('hidden');
    more.addEventListener('click', () => {
      const expanded = text.classList.toggle('line-clamp-5') === false;
      more.textContent = expanded ? 'Show less' : 'More';
    });
  });
</script>
