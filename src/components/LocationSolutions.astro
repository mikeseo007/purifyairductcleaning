---
// Section 2 on a location page: "Air Duct Cleaning Solutions for Dusty and
// Contaminated HVAC Systems". A card grid (no large image) so the four SEO
// sections do not all read as the same text-and-image block.
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { SolutionCard } from '../data/location-content';

interface Props {
  heading: string;
  intro: string;
  items: SolutionCard[];
}

const { heading, intro, items } = Astro.props;
---

<section class="section relative overflow-hidden bg-surface">
  <div class="container-x relative">
    <SectionHeading eyebrow="What we clean" title={heading} intro={intro} center />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        items.map((item, i) => (
          <div class="card card-hover spotlight flex h-full flex-col p-6">
            <div class="flex items-center justify-between">
              <span class="icon-chip size-12">
                <Icon name={item.icon} class="size-6" />
              </span>
              <span class="font-display text-2xl font-bold text-sky-100">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-5 text-lg leading-snug">{item.title}</h3>
            <p class="mt-2 flex-1 leading-relaxed text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
