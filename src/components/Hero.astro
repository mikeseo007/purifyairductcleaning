---
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import QuoteForm from './QuoteForm.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { site, type Location } from '../data/site';
import { photos } from '../data/photos';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  location?: Location;
  service?: string;
  breadcrumbs?: { name: string; path: string }[];
  points?: string[];
  secondaryHref?: string;
  secondaryLabel?: string;
  dark?: boolean;
  panel?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  location,
  service,
  breadcrumbs,
  points = ['Cleaner indoor air', 'Improved HVAC efficiency', 'Healthier home and family'],
} = Astro.props;
const { rating, reviewCount, reviewsUrl } = site.google;
---

<section class="relative isolate overflow-hidden bg-navy-950 pb-16 lg:pb-24">
  <HeroBackdrop image={photos.livingRoomCleaning.src} imageAlt={photos.livingRoomCleaning.alt} position="object-[62%_center]" />

  <div class="container-x grid items-center gap-10 pt-10 lg:grid-cols-12 lg:gap-12 lg:pt-16">
    <div class="lg:col-span-7">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} dark />}
      {eyebrow && (
        <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-white/10 py-1.5 pr-4 pl-3 text-sm font-semibold text-white ring-1 ring-white/15">
          <span class="size-2 rounded-full bg-lime-400"></span>
          {eyebrow}
        </p>
      )}
      <h1 class="max-w-[12ch] text-[2.6rem] leading-[1.02] !text-white sm:text-6xl lg:text-[4.4rem]">
        {title.split('\n').map((line) => <span class="block">{line}</span>)}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/75">{subtitle}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {points.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white ring-1 ring-white/10">
            <Icon name="check" class="size-4 text-lime-400" />
            {p}
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-hero-cta>
        <a href={site.phoneHref} class="btn-primary">
          <Icon name="phone" class="size-5" />
          Call {site.phone}
        </a>
        <a href="#quote" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-6 py-3 font-bold text-white hover:bg-white hover:text-navy-950">
          Get a Free Quote
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>
      <a href={reviewsUrl} target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-3 text-white">
        <span class="font-display text-2xl font-bold">{rating.toFixed(1)}</span>
        <span>
          <span class="flex text-[#FBBC04]" aria-label={`${rating.toFixed(1)} out of 5 stars`}>
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
          </span>
          <span class="block text-sm text-white/70">{reviewCount} Google reviews</span>
        </span>
      </a>
    </div>
    <div class="lg:col-span-5">
      <QuoteForm location={location} service={service} />
    </div>
  </div>
</section>
