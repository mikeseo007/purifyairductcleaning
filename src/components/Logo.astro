---
import { Image } from 'astro:assets';
import mark from '../assets/images/purify-icon.png';

interface Props {
  tone?: 'dark' | 'light';
  size?: 'md' | 'lg';
}

const { tone = 'dark', size = 'md' } = Astro.props;
const light = tone === 'light';
const large = size === 'lg';
---

<span class="inline-flex min-w-0 items-center gap-3">
  <Image src={mark} alt="" width={160} densities={[1, 2]} class:list={['shrink-0', large ? 'size-14 sm:size-16' : 'size-10 sm:size-11']} />
  <span class="min-w-0 leading-tight">
    <span class:list={['block font-sans font-bold tracking-tight', large ? 'text-lg sm:text-xl' : 'text-[0.95rem] sm:text-base', light ? 'text-white' : 'text-navy-900']}>Purify Air</span>
    <span class:list={['block font-medium', large ? 'text-sm' : 'text-[0.68rem] sm:text-xs', light ? 'text-white/70' : 'text-muted']}>Duct Cleaning</span>
  </span>
</span>
