---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { cardPhotoFor } from '../data/photos';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  city?: string;
  current?: string;
  bg?: 'white' | 'sky';
  carousel?: boolean;
  avoid?: unknown;
}

const {
  title = 'Complete Air Duct & HVAC Cleaning Services in Aventura, FL',
  intro = 'We provide professional cleaning solutions for your entire HVAC system, helping you breathe cleaner air.',
  city,
  current,
} = Astro.props;

const heading = city ? `${title} in ${city}` : title;
---

<section id="services" class="scroll-mt-20 bg-white py-14" data-home-services>
  <div class="container-x">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[11px] font-bold tracking-[0.16em] text-sky-500 uppercase">Our services</p>
        <h2 class="mt-2 max-w-xl text-[1.7rem] leading-tight sm:text-3xl">{heading}</h2>
      </div>
      <div class="flex items-center gap-3 lg:text-right">
        <p class="max-w-xs text-sm text-muted">{intro}</p>
        <div class="flex shrink-0 gap-2">
          <button type="button" class="flex size-10 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-900 shadow-sm hover:bg-sky-50" aria-label="Previous services" data-services-prev>
            <Icon name="chevronRight" class="size-5 rotate-180" />
          </button>
          <button type="button" class="flex size-10 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-900 shadow-sm hover:bg-sky-50" aria-label="Next services" data-services-next>
            <Icon name="chevronRight" class="size-5" />
          </button>
        </div>
      </div>
    </div>
    <div class="relative mt-8">
      <ul class="-mx-1 flex snap-x snap-mandatory gap-5 overflow-x-auto px-1 py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-services-track aria-label="All services">
        {
          services.map((s) => {
            const photo = cardPhotoFor(s.slug);
            return (
              <li class="w-[82%] shrink-0 snap-start sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)]">
                <a
                  href={s.path}
                  aria-current={s.slug === current ? 'page' : undefined}
                  class:list={[
                    'group flex h-full flex-col overflow-hidden rounded-xl bg-white shadow-[0_10px_30px_-18px_rgb(11_51_43/0.35)] ring-1 ring-slate-100',
                    s.slug === current && 'ring-2 ring-sky-500',
                  ]}
                >
                  <span class="relative block">
                    <Image src={photo.src} alt={photo.alt} format="webp" widths={[400, 640, 800]} sizes="(min-width: 1024px) 280px, 50vw" class:list={['aspect-[16/10] w-full object-cover', photo.position]} />
                  </span>
                  <span class="relative flex flex-1 flex-col px-4 pt-7 pb-4">
                    <span class="absolute -top-5 left-4 flex size-10 items-center justify-center rounded-lg bg-sky-500 text-white shadow-md">
                      <Icon name={s.icon} class="size-5" />
                    </span>
                    <span class="text-base font-bold text-navy-900">{s.name}</span>
                    <span class="mt-1.5 flex-1 text-sm leading-relaxed text-muted">{s.card}</span>
                    <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-sky-600">Learn More <Icon name="arrowRight" class="size-3.5" /></span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
    <a href="/our-services/" class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-sky-600">View All Services <Icon name="arrowRight" class="size-4" /></a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-services]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const track = root.querySelector<HTMLElement>('[data-services-track]');
    if (!track) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const distance = () => {
      const card = track.children[0] as HTMLElement | undefined;
      if (!card) return track.clientWidth;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 20;
      return card.offsetWidth + gap;
    };
    const move = (direction: number) => {
      const max = track.scrollWidth - track.clientWidth;
      const next = track.scrollLeft + direction * distance();
      if (direction > 0 && next >= max - 4) {
        track.scrollTo({ left: 0, behavior: reduce ? 'auto' : 'smooth' });
        return;
      }
      if (direction < 0 && track.scrollLeft <= 4) {
        track.scrollTo({ left: max, behavior: reduce ? 'auto' : 'smooth' });
        return;
      }
      track.scrollBy({ left: direction * distance(), behavior: reduce ? 'auto' : 'smooth' });
    };
    root.querySelector('[data-services-prev]')?.addEventListener('click', () => move(-1));
    root.querySelector('[data-services-next]')?.addEventListener('click', () => move(1));
  });
</script>
