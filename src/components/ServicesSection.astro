---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { ImageMetadata } from 'astro';
import { serviceGroups, servicesByGroup, type GroupId } from '../data/services';
import { site } from '../data/site';
import { asPhoto, photos, pickPhoto, usedKeys, type Photo } from '../data/photos';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  city?: string;
  current?: string;
  bg?: 'white' | 'sky';
  /** Photos already shown elsewhere on the page. */
  avoid?: ImageMetadata[];
}

const {
  eyebrow = 'Our Services',
  title = 'Air Duct, Dryer Vent & HVAC Cleaning Services',
  intro = 'We clean the ductwork that carries conditioned air and the HVAC equipment that cools it. Dryer vent cleaning is available for homes and commercial laundry rooms.',
  city,
  current,
  bg = 'white',
  avoid = [],
} = Astro.props;

const alternates: Record<GroupId, Photo[]> = {
  duct: [photos.livingRoom, photos.brightHome, photos.techWork, photos.plans, photos.homeExterior],
  hvac: [photos.acOutdoor, photos.techPanel, photos.techWork, photos.plans],
  dryer: [photos.laundry, photos.homeExterior, photos.condoTowers, photos.brightHome],
};
const used = new Set(usedKeys(avoid));

const groups = serviceGroups.map((g) => {
  const photo = pickPhoto([asPhoto(g.image, g.imageAlt), ...alternates[g.id]], used, { minWidth: 1100, landscape: true });
  return { ...g, image: photo.src, imageAlt: photo.alt, label: g.name.replace(/ Services$/, ''), items: servicesByGroup(g.id) };
});
const activeIndex = Math.max(0, groups.findIndex((g) => g.items.some((s) => s.slug === current)));
const uid = `svc-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['section relative overflow-hidden', bg === 'sky' ? 'bg-surface' : 'bg-white']}>
  <div class="container-x relative">
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />

    <div class="mt-12 grid gap-8 lg:mt-16 lg:grid-cols-12 lg:gap-12" data-services>
      <div class="min-w-0 lg:col-span-4" data-reveal="left">
        <div
          role="tablist"
          aria-label="Service categories"
          aria-orientation="vertical"
          class="svc-tabs -mx-5 flex snap-x scroll-px-5 gap-2 overflow-x-auto px-5 pb-2 sm:mx-0 sm:px-0 lg:flex-col lg:gap-0 lg:overflow-visible lg:border-t lg:border-slate-200 lg:pb-0"
        >
          {
            groups.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`${uid}-tab-${i}`}
                aria-controls={`${uid}-panel-${i}`}
                aria-selected={i === activeIndex ? 'true' : 'false'}
                tabindex={i === activeIndex ? 0 : -1}
                class="svc-tab group relative flex shrink-0 snap-start items-center gap-4 rounded-full border border-slate-200 bg-white px-5 py-3 text-left transition duration-300 lg:rounded-none lg:border-0 lg:border-b lg:bg-transparent lg:px-0 lg:py-6"
              >
                <span class="svc-tab-num font-display text-sm font-bold text-slate-400 tabular-nums transition lg:text-base">0{i + 1}</span>
                <span class="min-w-0 flex-1">
                  <span class="svc-tab-label block font-display text-base font-bold whitespace-nowrap text-navy-900 transition lg:text-[1.45rem] lg:leading-tight lg:whitespace-normal">
                    {g.label}
                  </span>
                  <span class="mt-1 hidden text-sm text-muted lg:block">{g.items.length} services</span>
                </span>
                <span class="svc-tab-arrow hidden size-10 shrink-0 items-center justify-center rounded-full border border-slate-200 text-navy-900 transition duration-300 lg:flex">
                  <Icon name="arrowRight" class="size-4" />
                </span>
              </button>
            ))
          }
        </div>

        <div class="mt-8 hidden rounded-[1.75rem] bg-navy-950 p-7 text-white lg:block">
          <p class="font-display text-xl font-bold text-white">Not sure which service you need?</p>
          <p class="mt-2 text-sm leading-relaxed text-sky-100/75">Tell us what you’re noticing and we’ll point you to the right one.</p>
          <a href={site.phoneHref} class="btn-primary mt-5 w-full justify-center">
            <Icon name="phone" class="size-4" />
            {site.phone}
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-8" data-reveal="right">
        {
          groups.map((g, i) => (
            <div
              role="tabpanel"
              id={`${uid}-panel-${i}`}
              aria-labelledby={`${uid}-tab-${i}`}
              class="svc-panel"
              data-active={i === activeIndex ? '' : undefined}
            >
              <div class="card overflow-hidden">
                <div class="relative aspect-[4/3] overflow-hidden bg-navy-950 sm:aspect-[2/1]">
                  <Image
                    src={g.image}
                    alt={g.imageAlt}
                    title={g.imageAlt}
                    format="webp"
                    widths={[640, 960, 1280, 1536]}
                    sizes="(min-width: 1280px) 800px, (min-width: 1024px) 66vw, 100vw"
                    quality={85}
                    class="svc-img h-full w-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/25 to-transparent" />
                  <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-4 p-6 sm:p-8">
                    <div class="max-w-xl">
                      <p class="text-xs font-bold tracking-[0.2em] text-lime-400 uppercase">
                        {String(i + 1).padStart(2, '0')} · {g.items.length} services
                      </p>
                      <h3 class="mt-2 text-2xl leading-tight !text-white sm:text-[2rem]">
                        {city ? `${g.name} in ${city}` : g.name}
                      </h3>
                    </div>
                    <a href={g.hub} class="btn-primary hidden sm:inline-flex">
                      Learn more <Icon name="arrowRight" class="size-4" />
                    </a>
                  </div>
                </div>

                <p class="px-6 pt-6 leading-relaxed text-muted sm:px-8 sm:pt-7">{g.intro}</p>

                <ul class="grid gap-x-6 p-4 sm:grid-cols-2 sm:p-6">
                  {g.items.map((s) => (
                    <li>
                      <a
                        href={s.path}
                        aria-current={s.slug === current ? 'page' : undefined}
                        class:list={[
                          'group flex items-center gap-4 rounded-2xl p-3 transition duration-300 hover:bg-surface',
                          s.slug === current && 'bg-surface ring-1 ring-sky-200',
                        ]}
                      >
                        <span class="icon-chip size-11 rounded-xl">
                          <Icon name={s.icon} class="size-5" />
                        </span>
                        <span class="min-w-0 flex-1 font-bold text-navy-900">{s.name}</span>
                        <Icon name="arrowRight" class="size-4 shrink-0 text-slate-300 transition group-hover:translate-x-1 group-hover:text-navy-900" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }

        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/our-services/" class="btn-navy">
            Compare all services <Icon name="arrowRight" class="size-4" />
          </a>
          <a href={site.phoneHref} class="font-bold text-navy-900 hover:text-sky-600 lg:hidden">
            Not sure? Call {site.phone}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-services]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    root.classList.add('is-tabbed');

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].toggleAttribute('data-active', on);
      });
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (step) {
          e.preventDefault();
          select((i + step + tabs.length) % tabs.length, true);
        } else if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          select(e.key === 'Home' ? 0 : tabs.length - 1, true);
        }
      });
    });
  });
</script>
