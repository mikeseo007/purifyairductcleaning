---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { photos } from '../data/photos';

interface Props {
  title?: string;
  text?: string;
  /** Quote button target. Defaults to the main-site contact page; Fort Lauderdale pages pass '#quote' to use the on-page form. */
  quoteHref?: string;
}

const {
  title = 'Get a Free Quote for Air Duct Cleaning in Aventura, FL',
  text = 'Breathe cleaner air. Call us or request a quote and we’ll schedule a time that works for your home or business.',
  quoteHref = '/contact-us/#quote',
} = Astro.props;
---

<section class="bg-white py-16 sm:py-20">
  <div class="container-x">
    <div class="grid overflow-hidden rounded-[2rem] bg-navy-950 text-white lg:grid-cols-2">
      <div class="flex flex-col justify-center px-6 py-12 sm:px-12 lg:py-16">
        <p class="text-xs font-bold tracking-[0.18em] text-lime-400 uppercase">Cleaner air starts here</p>
        <h2 class="mt-3 max-w-xl text-3xl leading-[1.05] !text-white sm:text-5xl">{title}</h2>
        <p class="mt-4 max-w-lg text-white/75">{text}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={quoteHref} class="btn-primary">Get a Free Quote</a>
          <a href={site.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-6 py-3 font-bold text-white hover:bg-white hover:text-navy-950">
            <Icon name="phone" class="size-5" />
            {site.phone}
          </a>
        </div>
      </div>
      <div class="relative min-h-64">
        <Image
          src={photos.livingRoomCleaning.src}
          alt={photos.livingRoomCleaning.alt}
          title={photos.livingRoomCleaning.alt}
          format="webp"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 560px, 100vw"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
