---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs?: string[];
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
  tint?: boolean;
  phone?: { label: string; href: string };
  headingLevel?: 'h2' | 'h3';
}

const { eyebrow, heading, paragraphs = [], image, imageAlt, reverse = false, tint = false, phone, headingLevel: H = 'h2' } = Astro.props;
const ratio = image.width / image.height;
// Stay close to the source shape. A short max-height on a full-width box was
// slicing tall job photos down to a band with no subject.
const frame = ratio > 1.05 ? { w: 19, h: 13 } : ratio > 0.68 ? { w: 4, h: 5 } : { w: 9, h: 16 };
// Very tall phone shots put the work at the ceiling. Near-matching frames stay centered.
const objectPosition = ratio < 0.62 ? 'center 18%' : 'center 50%';
---

<section class:list={['section relative overflow-hidden', tint ? 'bg-surface' : 'bg-white']}>
  <div class="container-x relative grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div
      class:list={['relative mx-auto w-full', reverse && 'lg:order-2']}
      style={`max-width: calc(40rem * ${frame.w} / ${frame.h})`}
      data-reveal={reverse ? 'right' : 'left'}
    >
      <div
        class="unmask relative overflow-hidden rounded-[1.75rem] bg-navy-950 shadow-[0_40px_80px_-40px_rgb(7_19_48/0.55)]"
        style={`aspect-ratio: ${frame.w} / ${frame.h}`}
      >
        <Image
          src={image}
          alt={imageAlt}
          title={imageAlt}
          format="webp"
          widths={[480, 760, 960, 1200, 1536]}
          sizes="(min-width: 1024px) 600px, 100vw"
          class="parallax size-full object-cover"
          style={`object-position: ${objectPosition}`}
        />
        <div class="pointer-events-none absolute inset-0 rounded-[1.75rem] ring-1 ring-white/10 ring-inset"></div>
      </div>
      <div
        class:list={[
          'float absolute flex items-center gap-3 rounded-2xl bg-white/95 p-3 pr-5 shadow-[0_20px_40px_-16px_rgb(7_19_48/0.4)] ring-1 ring-slate-200/60 backdrop-blur',
          reverse ? '-right-3 bottom-8 sm:-right-6' : '-left-3 top-8 sm:-left-6',
        ]}
        aria-hidden="true"
      >
        <span class="icon-chip size-10"><Icon name={reverse ? 'shield' : 'clock'} class="size-5" /></span>
        <span>
          <span class="block text-sm font-bold text-navy-900">{reverse ? 'Upfront quotes' : 'Open 24 hours'}</span>
          <span class="block text-xs text-muted">{reverse ? 'Scope agreed before work' : 'Open 24 hours'}</span>
        </span>
      </div>
    </div>
    <div class:list={[reverse && 'lg:order-1']} data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <H class="text-[2rem] leading-[1.1] sm:text-[2.6rem]">{heading}</H>
      <div class="prose-purix mt-7">
        {paragraphs.map((p) => <p set:html={p} />)}
        <slot />
      </div>
      {
        phone && (
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={phone.href} class="btn-navy !py-3.5">
              <Icon name="phone" class="size-5" />
              Call Now: {phone.label}
            </a>
            <a href="#quote" class="group inline-flex items-center gap-1.5 font-bold text-navy-700 hover:text-sky-500">
              Request a free quote
              <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
