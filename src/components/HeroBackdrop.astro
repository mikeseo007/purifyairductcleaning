---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  imageAlt?: string;
  position?: string;
}

const { image, imageAlt = '', position = 'object-[70%_center]' } = Astro.props;
---

<div class:list={['hero-scene pointer-events-none absolute inset-0 -z-10 overflow-hidden', image && 'hero-scene--photo']}>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        title={imageAlt}
        format="webp"
        widths={[960, 1400, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class:list={['hero-parallax size-full scale-105 object-cover', position]}
      />
    )
  }
  {image && <div class="hero-scene__wash absolute inset-0"></div>}
</div>
