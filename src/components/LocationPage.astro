---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Hero from './Hero.astro';
import TrustBar from './TrustBar.astro';
import SplitSection from './SplitSection.astro';
import ServicesSection from './ServicesSection.astro';
import HvacHighlight from './HvacHighlight.astro';
import ProcessSteps from './ProcessSteps.astro';
import Reviews from './Reviews.astro';
import ReviewWidget from './ReviewWidget.astro';
import LocationSolutions from './LocationSolutions.astro';
import LocationSigns from './LocationSigns.astro';
import LocationPoi from './LocationPoi.astro';
import FAQ from './FAQ.astro';
import LocationDetails from './LocationDetails.astro';
import LocationsSection from './LocationsSection.astro';
import CtaBand from './CtaBand.astro';
import QuoteSection from './QuoteSection.astro';
import { getLocation, locations, site } from '../data/site';
import { locationContent, locationImages } from '../data/location-content';
import { serviceAreaSchema, faqSchema } from '../data/schema';
import { isFortLauderdaleLocation, fortLauderdaleLandingSlug, fortLauderdale, fortLauderdaleServiceAreas } from '../data/fort-lauderdale';
import { fortLauderdaleServices, fortLauderdaleHighlightPoints } from '../data/fort-lauderdale-services';
import { fortLauderdaleDirections } from '../data/fort-lauderdale-directions';
import { fortLauderdaleCommercial, fortLauderdaleCommercialLanding } from '../data/fort-lauderdale-commercial';
import { photos } from '../data/photos';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const location = getLocation(slug);
const c = locationContent[slug];
const city = location.city;
// Fort Lauderdale assignment: the FL landing page + the 12 approved FL location pages use the
// FL header/footer and FL business schema. The FL map embed stays exclusive to the FL landing page.
const isFL = isFortLauderdaleLocation(slug);
const isFLLanding = slug === fortLauderdaleLandingSlug;
// On the FL landing page, the services grid shows the eleven dedicated Fort Lauderdale services.
const flServiceItems = fortLauderdaleServices.map((s) => ({
  slug: s.slug,
  path: s.path,
  name: s.name,
  card: s.card,
  icon: s.icon,
  image: s.cardImage ?? s.image,
  imageAlt: s.cardImageAlt ?? s.imageAlt,
  position: 'object-center',
}));
const index = locations.findIndex((l) => l.slug === slug);
const images = locationImages(index < 0 ? 0 : index);
const phone = { label: site.phone, href: site.phoneHref };

// Section headings follow the required structure, adapted to the city.
const healthierHeading = `Residential Air Duct Cleaning in ${city} for Healthier Living`;
const solutionsHeading = 'Air Duct Cleaning Solutions for Dusty and Contaminated HVAC Systems';
const signsHeading = `Signs Your ${city} Home May Need Air Duct Cleaning Service`;
const allergyHeading = `Expert Air Duct Cleaning in ${city} for Homes with Allergy and Dust Concerns`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path: '/service-areas/' },
  { name: city, path: location.path },
];

// JSON-LD scoping (visible breadcrumbs, FAQs and service-area content are rendered separately and unaffected):
//  - FL landing page: Organization + LocalBusiness only — no BreadcrumbList / Service / FAQPage JSON-LD.
//  - FL location pages: keep FAQPage + BreadcrumbList; drop the service-area Service entity.
//  - Main-site location pages: unchanged (service-area Service + FAQPage + BreadcrumbList + WebPage).
const layoutBreadcrumbs = isFLLanding ? undefined : breadcrumbs;
const pageSchema = isFLLanding
  ? []
  : isFL
    ? [faqSchema(c.faqs)]
    : [serviceAreaSchema(location), faqSchema(c.faqs)];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  location={location}
  breadcrumbs={layoutBreadcrumbs}
  schema={pageSchema}
  variant={isFL ? 'fortLauderdale' : 'main'}
  localBusiness={isFLLanding}
>
  <Hero
    eyebrow={`Serving ${city} & ${location.county}`}
    title={`Air Duct Cleaning in ${city}, FL`}
    subtitle={c.h1Description}
    image={images.hero}
    imageAlt={images.heroAlt}
    location={location}
    breadcrumbs={breadcrumbs}
    secondaryHref="/contact-us/#quote"
    secondaryLabel="Contact Us"
    points={['Residential air duct cleaning', 'Dust and debris removed at the source', 'Cleaner indoor air']}
  />

  <TrustBar
    servicesStat={isFL ? { value: '11', label: 'Dedicated Services', text: 'Duct, AC vent, dryer vent, coil, mold & insulation' } : undefined}
    locationsStat={isFL ? { value: '12', label: 'Service Locations', text: 'Fort Lauderdale & nearby communities' } : undefined}
  />

  {/* First half: services, about us, breathe the difference, testimonials, then SEO sections 1 and 2 */}
  <ServicesSection
    title="Air Duct, Dryer Vent & HVAC Cleaning Services"
    intro={`Duct, HVAC, and dryer vent cleaning for homes and businesses in ${city}, FL.`}
    city={city}
    bg="white"
    items={isFLLanding ? flServiceItems : undefined}
    viewAllHref={isFLLanding ? null : undefined}
  />

  <SplitSection
    eyebrow="About us"
    heading={`${city}’s Trusted Air Duct Cleaning Team`}
    paragraphs={[
      `Purify Air Duct Cleaning Fort Lauderdale helps homeowners across ${city} breathe cleaner air. We focus on residential air duct cleaning, using source removal and careful, contained work on every visit.`,
    ]}
    image={photos.serviceVanCrew.src}
    imageAlt={photos.serviceVanCrew.alt}
    tint
    points={['Residential and commercial cleaning', 'Ducts, HVAC equipment, and dryer vents', 'Open 24 hours, 7 days', 'Upfront quotes before any work']}
    stat={{ value: '24/7', label: 'Open every day' }}
    showRating
    link={isFLLanding ? { href: '#quote', label: 'Request Service' } : { href: '/about-us/', label: 'About Our Services' }}
    phone={phone}
  />

  <HvacHighlight points={isFL ? fortLauderdaleHighlightPoints : undefined} />

  <Reviews title={`Trusted by Homeowners and Businesses in ${city}`} eyebrow="What our customers say" />
  {/* "Leave Us a Review" button is limited to the Fort Lauderdale landing + its associated location pages. */}
  {isFL && <ReviewWidget />}

  {/* SEO section 1: image + text */}
  <SplitSection
    eyebrow={`Residential service in ${city}`}
    heading={healthierHeading}
    paragraphs={c.healthier}
    image={images.healthier}
    imageAlt={images.healthierAlt}
    tint
    phone={phone}
  />

  {/* SEO section 2: card grid */}
  <LocationSolutions heading={solutionsHeading} intro={c.solutionsIntro} items={c.solutions} />

  {/* Second half: SEO sections 3 and 4, process, points of interest, service areas, then FAQs */}
  {/* SEO section 3: checklist */}
  <LocationSigns heading={signsHeading} intro={c.signsIntro} signs={c.signs} />

  {/* SEO section 4: image + text */}
  <SplitSection
    eyebrow={`Allergy & dust relief in ${city}`}
    heading={allergyHeading}
    paragraphs={c.allergy}
    image={images.allergy}
    imageAlt={images.allergyAlt}
    reverse
    tint
    phone={phone}
  />

  <ProcessSteps title={`How Air Duct Cleaning Works in ${city}`} bg="white" />

  <LocationPoi city={city} pois={c.pois} />

  {/* Related Services: internal links to the dedicated Fort Lauderdale service pages (12 FL location pages only). */}
  {isFL && !isFLLanding && (
    <section class="bg-white py-14">
      <div class="container-x">
        <p class="eyebrow">Related services</p>
        <h2 class="text-3xl sm:text-4xl">Related Services in Fort Lauderdale</h2>
        <p class="mt-3 max-w-2xl text-muted">Explore our dedicated Fort Lauderdale duct, AC vent, and dryer vent services, each available to homes and businesses in {city}.</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {fortLauderdaleServices.map((s) => (
            <li>
              <a href={s.path} class="card card-hover group flex h-full items-start gap-4 p-5">
                <span class="icon-chip size-11 shrink-0"><Icon name={s.icon} class="size-5" /></span>
                <span class="flex flex-col">
                  <span class="font-display text-base leading-snug font-bold text-navy-900 group-hover:text-sky-600">{s.name} in Fort Lauderdale</span>
                  <span class="mt-1 text-sm leading-relaxed text-muted">{s.card}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Commercial air duct cleaning: a dedicated section on the FL landing page (anchor target), and a
      concise, locally varied mention on each of the 12 FL-associated location pages linking back to it. */}
  {isFLLanding && (
    <section id="commercial-air-duct-cleaning" class="scroll-mt-20 bg-[#f7fbf8] py-14">
      <div class="container-x grid items-start gap-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow">{fortLauderdaleCommercialLanding.eyebrow}</p>
          <h2 class="text-3xl sm:text-4xl">{fortLauderdaleCommercialLanding.heading}</h2>
          {fortLauderdaleCommercialLanding.paragraphs.map((p) => (
            <p class="mt-4 max-w-xl leading-relaxed text-muted">{p}</p>
          ))}
          <a href={fortLauderdaleCommercialLanding.ctaHref} class="btn-primary mt-8">{fortLauderdaleCommercialLanding.ctaLabel}</a>
        </div>
        <div class="card p-6 sm:p-8">
          <p class="text-sm font-bold tracking-wide text-navy-900 uppercase">Commercial duct cleaning covers</p>
          <ul class="mt-5 space-y-3" data-stagger>
            {fortLauderdaleCommercialLanding.points.map((pt) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-600"><Icon name="check" class="size-4" /></span>
                <span class="text-muted">{pt}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 border-t border-slate-100 pt-5 text-sm leading-relaxed text-muted">{fortLauderdaleCommercialLanding.assessment}</p>
        </div>
      </div>
    </section>
  )}

  {isFL && !isFLLanding && fortLauderdaleCommercial[slug] && (
    <section class="bg-[#f7fbf8] py-14">
      <div class="container-x">
        <p class="eyebrow">Commercial service</p>
        <h2 class="text-3xl sm:text-4xl">Commercial Air Duct Cleaning in {city}</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-muted">{fortLauderdaleCommercial[slug]}</p>
        <a href="/air-duct-cleaning-fort-lauderdale/#commercial-air-duct-cleaning" class="mt-6 inline-flex items-center gap-2 font-bold text-navy-900 hover:text-sky-600">
          Learn about commercial air duct cleaning in Fort Lauderdale
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>
    </section>
  )}

  <LocationsSection
    title={`Proudly Serving ${city}, FL and Nearby Areas`}
    intro={`We clean air ducts, HVAC systems, and dryer vents across ${location.county} and nearby South Florida cities.`}
    current={location.slug}
    showMap={true}
    mapEmbed={isFL ? fortLauderdale.mapEmbed : undefined}
    mapLink={isFL ? fortLauderdale.mapLink : undefined}
    label={isFL ? fortLauderdale.name : undefined}
    areaList={isFL ? fortLauderdaleServiceAreas : undefined}
    mapClass={isFL ? 'h-[300px] lg:h-[440px]' : undefined}
    cta={isFL ? { text: 'We serve Fort Lauderdale and 12 nearby Broward communities. Don’t see your neighborhood? Call or send a quote request and we’ll let you know.', href: '#quote', label: 'Request a Quote' } : undefined}
    directionsEmbed={isFL && !isFLLanding ? fortLauderdaleDirections[slug] : undefined}
    directionsTitle={`Driving directions from ${city} to our Fort Lauderdale office`}
  />

  <FAQ faqs={c.faqs} title={`Air Duct Cleaning FAQs: ${city}`} tint />

  <QuoteSection
    eyebrow="Free quote"
    title={`Request air duct cleaning in ${city}`}
    text={`Tell us about the property and we’ll follow up to schedule. ${site.hours.long}`}
  />

  <LocationDetails location={location} />

  <CtaBand
    title={`Get a Free Quote for Air Duct Cleaning in ${city}, FL`}
    text="Breathe cleaner air. Call us or request a quote and we’ll schedule a time that works for your home or business."
    quoteHref={isFL ? '#quote' : undefined}
  />
</BaseLayout>
