---
// Points-of-interest section for a location page. Real local areas with a line
// on why they matter for residential air duct cleaning, not a bare list of names.
import Icon from './Icon.astro';
import type { Poi } from '../data/location-content';

interface Props {
  city: string;
  pois: Poi[];
}

const { city, pois } = Astro.props;
---

<section class="section bg-surface">
  <div class="container-x">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Around town</p>
      <h2 class="text-[2rem] leading-[1.08] sm:text-4xl">Air duct cleaning across {city}</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
        {city} homes are not all alike. These are a few of the areas we keep in mind when we plan a residential air duct cleaning here.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        pois.map((poi) => (
          <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6">
            <span class="flex size-10 items-center justify-center rounded-xl bg-sky-500/10 text-sky-600">
              <Icon name="pin" class="size-5" />
            </span>
            <h3 class="mt-4 text-lg leading-snug text-navy-900">{poi.name}</h3>
            <p class="mt-2 flex-1 leading-relaxed text-muted">{poi.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
