---
import GoogleMap from './GoogleMap.astro';
import ServiceAreaList from './ServiceAreaList.astro';

interface Props {
  title?: string;
  intro?: string;
  current?: string;
  service?: { name: string };
  showMap?: boolean;
  tint?: boolean;
  id?: string;
  /** Map embed/link/label passthrough. Undefined → GoogleMap's Aventura defaults. */
  mapEmbed?: string;
  mapLink?: string;
  label?: string;
  /** Optional scoped service-area list (e.g. the 12 Fort Lauderdale areas). Undefined → full region list. */
  areaList?: { slug?: string; path: string; city: string }[];
  /** Map sizing classes. Default keeps the existing (Aventura) proportions; FL pages pass a shorter map. */
  mapClass?: string;
  /** Optional CTA shown below the service-area list to balance the column against the map (FL pages). */
  cta?: { text: string; href: string; label: string };
  /** Optional driving-directions map embed, rendered below the grid in ADDITION to the business map. */
  directionsEmbed?: string;
  /** Heading for the driving-directions map. */
  directionsTitle?: string;
}

const {
  title = 'Areas We Serve in South & Southwest Florida',
  intro = 'Based in Aventura, Purify serves homes and businesses across northern Miami-Dade, Broward and Boca Raton.',
  current,
  service,
  showMap = true,
  id,
  mapEmbed,
  mapLink,
  label,
  areaList,
  mapClass = 'h-[340px] lg:h-[560px]',
  cta,
  directionsEmbed,
  directionsTitle = 'Driving directions',
} = Astro.props;
---

<section id={id} class="bg-[#f7fbf8] py-14">
  <div class:list={['container-x grid items-start gap-8', showMap && 'lg:grid-cols-2']}>
    <div>
      <p class="text-[11px] font-bold tracking-[0.16em] text-sky-500 uppercase">Service areas</p>
      <h2 class="mt-2 text-2xl leading-tight">{title}</h2>
      <p class="mt-3 text-sm text-muted">{intro}</p>
      <div class="mt-6">
        <ServiceAreaList current={current} serviceName={service?.name} areaList={areaList} />
      </div>
      {cta && (
        <div class="mt-8 flex flex-col gap-4 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm leading-relaxed text-muted">{cta.text}</p>
          <a href={cta.href} class="btn-primary shrink-0">{cta.label}</a>
        </div>
      )}
    </div>
    {showMap && <GoogleMap bare class={mapClass} embed={mapEmbed} mapLink={mapLink} label={label} />}
  </div>
  {directionsEmbed && (
    <div class="container-x mt-10">
      <p class="text-[11px] font-bold tracking-[0.16em] text-sky-500 uppercase">Driving directions</p>
      <h3 class="mt-2 text-xl leading-tight">{directionsTitle}</h3>
      <div class="mt-4">
        <GoogleMap bare class="h-[320px] sm:h-[380px] lg:h-[440px]" embed={directionsEmbed} label={directionsTitle} />
      </div>
    </div>
  )}
</section>
