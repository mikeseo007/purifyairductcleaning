---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  breadcrumbs: { name: string; path: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, subtitle, breadcrumbs, image, imageAlt = '' } = Astro.props;
---

<section class:list={['relative isolate overflow-hidden', image ? 'bg-navy-950' : 'bg-[#03110e]']}>
  {
    image ? (
      <>
        <Image
          src={image}
          alt={imageAlt}
          title={imageAlt}
          format="webp"
          widths={[960, 1400, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="pointer-events-none absolute inset-0 size-full object-cover object-[68%_center]"
        />
        <div class="page-hero-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
      </>
    ) : (
      <div class="page-hero pointer-events-none absolute inset-0" aria-hidden="true"></div>
    )
  }

  <div class="container-x relative grid items-center lg:grid-cols-[minmax(0,32rem)_1fr] lg:gap-8">
    <div class="py-14 sm:py-16 lg:py-20">
      <Breadcrumbs items={breadcrumbs} dark />
      {eyebrow && <p class="eyebrow !text-lime-300">{eyebrow}</p>}
      <h1 class="max-w-xl text-[2.4rem] leading-[1.05] font-extrabold !text-white sm:text-5xl lg:text-[3.25rem]">{title}</h1>
      {subtitle && <p class="mt-5 max-w-md text-base leading-relaxed text-white/75 sm:text-lg">{subtitle}</p>}
    </div>

    {
      !image && (
      <div class="pointer-events-none absolute top-4 right-0 h-36 w-[58%] sm:h-44 lg:static lg:h-72 lg:w-full" aria-hidden="true">
      <svg class="size-full" viewBox="0 0 640 400" fill="none">
        <defs>
          <linearGradient id="page-hero-lime" x1="0" y1="120" x2="560" y2="40" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#d9f99d" stop-opacity="0" />
            <stop offset="0.18" stop-color="#bef264" stop-opacity="0.45" />
            <stop offset="0.62" stop-color="#ecfccb" stop-opacity="1" />
            <stop offset="1" stop-color="#f7fee7" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient id="page-hero-sky" x1="20" y1="260" x2="560" y2="280" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#7dd3fc" stop-opacity="0" />
            <stop offset="0.22" stop-color="#38bdf8" stop-opacity="0.4" />
            <stop offset="0.66" stop-color="#bae6fd" stop-opacity="1" />
            <stop offset="1" stop-color="#f0f9ff" stop-opacity="0.8" />
          </linearGradient>
          <filter id="page-hero-glow" x="-25%" y="-40%" width="150%" height="180%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <g stroke-linecap="round" fill="none">
          <path
            d="M-10 150C70 112 130 188 230 146C310 112 360 96 420 132C478 166 520 118 492 68C468 26 408 28 402 78C398 112 440 132 474 104"
            stroke="url(#page-hero-lime)"
            stroke-width="14"
            opacity="0.22"
          />
          <path
            d="M0 250C90 292 160 198 270 236C360 266 420 304 478 258C524 222 514 168 468 170C428 172 420 222 466 228"
            stroke="url(#page-hero-sky)"
            stroke-width="14"
            opacity="0.2"
          />
          <g filter="url(#page-hero-glow)">
            <path
              d="M-10 150C70 112 130 188 230 146C310 112 360 96 420 132C478 166 520 118 492 68C468 26 408 28 402 78C398 112 440 132 474 104"
              stroke="url(#page-hero-lime)"
              stroke-width="3.6"
            />
            <path
              d="M0 250C90 292 160 198 270 236C360 266 420 304 478 258C524 222 514 168 468 170C428 172 420 222 466 228"
              stroke="url(#page-hero-sky)"
              stroke-width="3.6"
            />
          </g>
        </g>
      </svg>
    </div>
      )
    }
  </div>
</section>
