---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import FAQ from './FAQ.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import LocationsSection from './LocationsSection.astro';
import Reviews from './Reviews.astro';
import ServicesSection from './ServicesSection.astro';
import QuoteForm from './QuoteForm.astro';
import { site } from '../data/site';
import { locationContent } from '../data/location-content';
import { photos } from '../data/photos';
import { faqSchema } from '../data/schema';

const c = locationContent.aventura;
const { rating } = site.google;

const stats = [
  { icon: 'star', value: '5.0', label: 'Customer Rating', note: 'Based on Google reviews' },
  { icon: 'shield', value: '10+', label: 'Years of Experience', note: 'Serving Aventura, FL' },
  { icon: 'clock', value: 'Same-Day', label: 'Service', note: 'Available in Aventura, FL' },
  { icon: 'home', value: '2,500+', label: 'Homes & Businesses Served', note: 'Across Miami-Dade County' },
];

const points = [
  'Specialized air duct cleaning equipment',
  'Dust and debris removed from the ducts',
  'Improved indoor air quality',
  'Residential and commercial service',
  'Trained, experienced technicians',
  '100% satisfaction guarantee',
];

const steps = [
  { title: 'Inspection', text: 'We inspect the system and vents to find buildup, debris, and problem areas.' },
  { title: 'Professional Cleaning', text: 'We remove dust and debris from the ducts with professional collection equipment.' },
  { title: 'Sanitizing (Optional)', text: 'An optional treatment for duct surfaces after the dust has been removed.' },
  { title: 'Final Check', text: 'We walk the system with you and show the results before we leave.' },
];

---

<BaseLayout title={c.metaTitle} description={c.metaDescription} schema={[faqSchema(c.faqs)]}>
  <Fragment slot="head">
    <meta name="google-site-verification" content="d-JukjnEeOu8lRmSIkwPJDtI3TUG8cUk-GYJp5kAHHM" />
  </Fragment>
  <section class="relative isolate overflow-hidden bg-navy-950">
    <HeroBackdrop image={photos.livingRoomCleaning.src} imageAlt={photos.livingRoomCleaning.alt} position="object-[62%_center]" />

    <div class="container-x grid items-center gap-8 py-10 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-10 lg:py-12">
      <div>
        <p class="text-[11px] font-bold tracking-[0.14em] text-lime-400 uppercase">Cleaner air • Healthier homes • Aventura, FL</p>
        <h1 class="mt-3 max-w-lg text-[2.6rem] leading-[1.05] !text-white sm:text-5xl">
          Professional<br />Air Duct Cleaning<br />in Aventura, FL
        </h1>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-white/80 sm:text-base">
          Breathe cleaner, healthier air with professional air duct cleaning. We remove dust, allergens and contaminants from your HVAC system for a cleaner, safer home.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="#quote" class="btn-primary !bg-lime-400 !px-5 !py-2.5 text-sm shadow-none">Get a Free Quote</a>
          <a href={site.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm font-bold text-white hover:bg-white hover:text-navy-950">
            <Icon name="phone" class="size-4" />
            Call {site.phone}
          </a>
        </div>
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] font-semibold text-white/90 lg:flex-nowrap">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="star" class="size-3.5 text-lime-400" />
            {rating.toFixed(1)} Average Rating
          </span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-lime-400" /> Licensed &amp; Insured</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-lime-400" /> Eco-Friendly Solutions</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-lime-400" /> Satisfaction Guarantee</span>
        </div>
      </div>
      <QuoteForm heading="Request a Free Quote" buttonLabel="Get My Free Quote" panel />
    </div>
  </section>

  <ServicesSection />

  <section class="border-y border-slate-100 bg-[#f7fbf8]">
    <div class="container-x grid grid-cols-2 gap-x-6 gap-y-5 py-7 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex items-start gap-3">
            <Icon name={s.icon} class="mt-1 size-6 shrink-0 text-sky-500" />
            <div>
              <p class="text-2xl leading-none font-bold text-navy-900">{s.value}</p>
              <p class="mt-1 text-sm font-bold text-navy-900">{s.label}</p>
              <p class="text-xs text-muted">{s.note}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div class="grid grid-cols-5 gap-3">
        <Image src={photos.ductVentCleaning.src} alt={photos.ductVentCleaning.alt} title={photos.ductVentCleaning.alt} format="webp" widths={[640, 960]} sizes="40vw" class="col-span-3 h-full min-h-72 rounded-2xl object-cover" />
        <div class="col-span-2 flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div class="relative overflow-hidden rounded-xl">
              <Image src={photos.coilBefore.src} alt={photos.coilBefore.alt} title={photos.coilBefore.alt} format="webp" widths={[240, 400]} sizes="15vw" class="h-28 w-full object-cover" />
              <span class="absolute bottom-1.5 left-1.5 rounded bg-black/70 px-1.5 py-0.5 text-[9px] font-bold text-white uppercase">Before</span>
            </div>
            <div class="relative overflow-hidden rounded-xl">
              <Image src={photos.coilAfter.src} alt={photos.coilAfter.alt} title={photos.coilAfter.alt} format="webp" widths={[240, 400]} sizes="15vw" class="h-28 w-full object-cover" />
              <span class="absolute bottom-1.5 left-1.5 rounded bg-sky-600 px-1.5 py-0.5 text-[9px] font-bold text-white uppercase">After</span>
            </div>
          </div>
          <Image src={photos.heroLiving.src} alt={photos.heroLiving.alt} title={photos.heroLiving.alt} format="webp" widths={[320, 640]} sizes="20vw" class="min-h-36 flex-1 rounded-xl object-cover" />
        </div>
      </div>
      <div>
        <p class="text-[11px] font-bold tracking-[0.16em] text-sky-500 uppercase">Why choose Purify</p>
        <h2 class="mt-2 text-3xl leading-tight">Aventura’s Trusted Air Duct Cleaning Company</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">We’re committed to cleaner air for healthier homes and businesses throughout Aventura and South Florida.</p>
        <div class="mt-5 grid items-center gap-4 sm:grid-cols-[1fr_11rem]">
          <ul class="grid gap-2 sm:grid-cols-2">
            {
              points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-navy-900">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-sky-500" />
                  {p}
                </li>
              ))
            }
          </ul>
          <div class="flex flex-col items-center rounded-2xl bg-sky-50 px-4 py-5 text-center text-sm leading-snug font-bold text-navy-900">
            <span class="mb-2 flex size-9 items-center justify-center rounded-full bg-sky-500 text-white"><Icon name="check" class="size-4" /></span>
            Cleaner Air. Healthier Families. A Brighter Aventura.
          </div>
        </div>
        <a href="/about-us/" class="btn-primary mt-6 !bg-lime-400 !px-5 !py-2.5 text-sm shadow-none">Learn More About Us</a>
      </div>
    </div>
  </section>

  <section class="bg-navy-950 py-14 text-white">
    <div class="container-x grid items-center gap-8 lg:grid-cols-2">
      <div>
        <p class="text-[11px] font-bold tracking-[0.16em] text-lime-400 uppercase">Why it matters</p>
        <h2 class="mt-2 max-w-lg text-3xl leading-tight !text-white">Remove Dust, Allergens and Contaminants for a Healthier Home</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-white/75">Professional air duct cleaning helps eliminate dust, allergens, pet dander, mold and other pollutants so you and your family can breathe cleaner air.</p>
        <ul class="mt-5 flex flex-wrap gap-2 text-xs font-semibold">
          <li class="rounded-full bg-white/10 px-3 py-1.5">Less allergens</li>
          <li class="rounded-full bg-white/10 px-3 py-1.5">Cleaner air</li>
          <li class="rounded-full bg-white/10 px-3 py-1.5">Better HVAC efficiency</li>
          <li class="rounded-full bg-white/10 px-3 py-1.5">A healthier home</li>
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="relative overflow-hidden rounded-xl">
          <Image src={photos.coilBefore.src} alt={photos.coilBefore.alt} title={photos.coilBefore.alt} format="webp" widths={[400, 700]} sizes="40vw" class="aspect-[4/3] w-full object-cover" />
          <span class="absolute bottom-3 left-3 rounded bg-black/70 px-2 py-1 text-[10px] font-bold tracking-wider text-white uppercase">Before</span>
        </div>
        <div class="relative overflow-hidden rounded-xl">
          <Image src={photos.coilAfter.src} alt={photos.coilAfter.alt} title={photos.coilAfter.alt} format="webp" widths={[400, 700]} sizes="40vw" class="aspect-[4/3] w-full object-cover" />
          <span class="absolute bottom-3 left-3 rounded bg-lime-400 px-2 py-1 text-[10px] font-bold tracking-wider text-navy-950 uppercase">After</span>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="bg-white py-14">
    <div class="container-x">
      <p class="text-center text-[11px] font-bold tracking-[0.16em] text-sky-500 uppercase">Our process</p>
      <h2 class="mt-2 text-center text-3xl">A Simple, Effective Cleaning Process</h2>
      <ol class="relative mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class="relative text-center">
              {i < steps.length - 1 && (
                <span aria-hidden="true" class:list={['pointer-events-none absolute top-5 left-[calc(50%+1.25rem)] h-px w-[calc(100%-1.25rem)] bg-sky-200', i % 2 === 1 ? 'hidden lg:block' : 'hidden sm:block']} />
              )}
              <span class="relative z-10 mx-auto flex size-10 items-center justify-center rounded-full bg-sky-500 text-sm font-bold text-white">{i + 1}</span>
              <h3 class="mt-3 text-base">{s.title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <LocationsSection
    id="service-areas"
    title="Proudly Serving Aventura, FL and Nearby Areas"
    intro="We clean air ducts for homes and businesses throughout Aventura and nearby South Florida communities."
    tint
  />

  <Reviews />

  <section class="bg-white py-10">
    <div class="container-x">
      <div class="grid overflow-hidden rounded-2xl bg-navy-950 text-white lg:grid-cols-[1.1fr_0.9fr]">
        <div class="grid items-center gap-6 px-6 py-8 sm:px-8 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="text-[11px] font-bold tracking-[0.16em] text-lime-400 uppercase">Ready for cleaner air</p>
            <h2 class="mt-2 max-w-md text-3xl leading-tight !text-white">Get a Free Quote for Air Duct Cleaning in Aventura, FL</h2>
            <p class="mt-2 text-sm text-white/70">Cleaner air. Healthier homes. Trusted local experts.</p>
            <div class="mt-5 flex flex-wrap gap-3">
              <a href="#quote" class="btn-primary !bg-lime-400 !px-5 !py-2.5 text-sm shadow-none">Get a Free Quote</a>
              <a href={site.phoneHref} class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-2.5 text-sm font-bold">
                <Icon name="phone" class="size-4" /> Call {site.phone}
              </a>
            </div>
          </div>
          <ul class="grid gap-2 text-sm font-semibold text-white/90">
            <li class="inline-flex items-center gap-2"><Icon name="check" class="size-4 text-lime-400" /> Fast &amp; friendly service</li>
            <li class="inline-flex items-center gap-2"><Icon name="check" class="size-4 text-lime-400" /> Upfront quotes</li>
            <li class="inline-flex items-center gap-2"><Icon name="check" class="size-4 text-lime-400" /> Licensed &amp; insured</li>
            <li class="inline-flex items-center gap-2"><Icon name="check" class="size-4 text-lime-400" /> Satisfaction guarantee</li>
          </ul>
        </div>
        <Image src={photos.exteriorVentHose.src} alt={photos.exteriorVentHose.alt} title={photos.exteriorVentHose.alt} format="webp" widths={[640, 960]} sizes="(min-width: 1024px) 480px, 100vw" class="h-56 w-full object-cover lg:h-full" />
      </div>
    </div>
  </section>

  <FAQ faqs={c.faqs} title="Air Duct Cleaning FAQs" />
</BaseLayout>
