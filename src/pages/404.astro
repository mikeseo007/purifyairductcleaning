---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LocationsSection from '../components/LocationsSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { getService } from '../data/services';
import { site } from '../data/site';
import { photos, asPhoto, pickPhoto } from '../data/photos';

const used = new Set<string>([photos.beachCity.family, photos.beachCity.src.src]);
const popular = ['air-duct-cleaning', 'dryer-vent-cleaning', 'hvac-cleaning', 'air-duct-sanitizing'].map((slug) => {
  const s = getService(slug);
  const photo = pickPhoto([asPhoto(s.image, s.imageAlt), asPhoto(s.secondImage, s.secondImageAlt)], used, { minWidth: 900 });
  return { ...s, image: photo.src, imageAlt: photo.alt };
});
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="border-b border-slate-100 bg-surface">
    <div class="container-x py-16 sm:py-20">
      <p class="eyebrow">Page not found</p>
      <h1 class="max-w-3xl text-4xl sm:text-5xl">This page doesn’t exist</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">The address may have changed. Head home, browse services, or call and we’ll point you to the right page.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Back to home <Icon name="arrowRight" class="size-4" /></a>
        <a href={site.phoneHref} class="btn-outline"><Icon name="phone" class="size-4" /> {site.phone}</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading eyebrow="Popular services" title="Looking for one of these?" center />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          popular.map((s) => (
            <li>
              <a href={s.path} class="card card-hover group flex h-full flex-col overflow-hidden">
                <span class="relative block aspect-[16/10] overflow-hidden bg-navy-950">
                  <Image
                    src={s.image}
                    alt={s.imageAlt}
                    title={s.imageAlt}
                    format="webp"
                    widths={[400, 640, 800, 1000]}
                    sizes="(min-width: 1280px) 290px, (min-width: 1024px) 23vw, (min-width: 640px) 50vw, 100vw"
                    class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent" />
                  <span class="icon-chip absolute bottom-4 left-4 size-11 rounded-xl ring-2 ring-white/20">
                    <Icon name={s.icon} class="size-5" />
                  </span>
                </span>
                <span class="flex flex-1 flex-col p-6">
                  <span class="font-display text-lg leading-snug font-bold text-navy-900">{s.name}</span>
                  <span class="mt-2 flex-1 text-sm leading-relaxed text-muted">{s.card}</span>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-navy-900">
                    View service
                    <span class="flex size-7 items-center justify-center rounded-full bg-surface transition group-hover:translate-x-1 group-hover:bg-lime-400">
                      <Icon name="arrowRight" class="size-3.5" />
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <LocationsSection title="Areas We Serve" />
  <CtaBand />
</BaseLayout>
