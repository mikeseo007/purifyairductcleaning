---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout title="Thank You" description={`Thanks for contacting ${site.name}. We'll be in touch shortly.`} noindex>
  <section class="bg-surface py-20 lg:py-28">
    <div class="container-x max-w-3xl text-center">
      <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-sky-500 text-white">
        <Icon name="check" class="size-8" />
      </span>
      <h1 class="mt-6 text-4xl sm:text-5xl">Thank you. We got your request.</h1>
      <p class="mt-4 text-lg text-muted">A member of our team will contact you to confirm the details. Need help right away? Give us a call.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={site.phoneHref} class="btn-primary">
          <Icon name="phone" class="size-5" />
          {site.phone}
        </a>
        <a href="/" class="btn-outline">Back to home</a>
      </div>
      <p class="mt-5 text-sm text-muted">{site.hours.long}</p>
    </div>
  </section>
</BaseLayout>
