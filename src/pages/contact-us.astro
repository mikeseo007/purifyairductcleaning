---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { site } from '../data/site';
import { businessId } from '../data/schema';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact Us', path: '/contact-us/' },
];
---

<BaseLayout
  title="Contact Us - Purify Air Duct Cleaning"
  description="Contact Purify Air Duct Cleaning to schedule service or request a free quote for cleaner, healthier indoor air. We’re here to help."
  breadcrumbs={breadcrumbs}
  schema={[{ '@type': 'ContactPage', name: `Contact ${site.name}`, url: `${site.url}/contact-us/`, about: { '@id': businessId } }]}
>
  <section class="section relative overflow-hidden bg-surface">
    <div class="container-x relative grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div data-reveal>
          <p class="eyebrow">Get in touch</p>
          <h1 class="text-[2rem] leading-[1.1] sm:text-[2.6rem]">{site.name}</h1>
          <p class="mt-4 text-lg text-muted">Based in Aventura, serving Miami-Dade, Broward and Boca Raton.</p>
        </div>

        <ul class="mt-9 grid gap-5 sm:grid-cols-2" data-stagger>
          <li class="card card-hover p-6">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="phone" class="size-4" /> Phone</p>
            <a href={site.phoneHref} class="mt-2 block font-display text-3xl font-bold tracking-tight text-navy-900 hover:text-sky-500">{site.phone}</a>
          </li>
          <li class="card card-hover p-6">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="clock" class="size-4" /> Hours</p>
            <p class="mt-2 font-bold text-navy-900">{site.hours.long}</p>
          </li>
          <li class="card card-hover p-6">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="pin" class="size-4" /> Address</p>
            <address class="mt-2 font-bold text-navy-900 not-italic">
              {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}
            </address>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-1 inline-block text-sm font-semibold text-sky-500 hover:underline">Get directions</a>
          </li>
          <li class="card card-hover p-6">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="mail" class="size-4" /> Email</p>
            <a href={`mailto:${site.email}`} class="mt-2 block font-bold break-all text-navy-900 hover:text-sky-500">{site.email}</a>
          </li>
        </ul>

        <div class="mt-8" data-reveal>
          <GoogleMap class="h-[420px] lg:h-[520px]" />
        </div>

      </div>
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28" data-reveal="right">
          <div class="rounded-[2rem] bg-gradient-to-br from-sky-300 via-sky-100 to-lime-400 p-px">
            <QuoteForm heading="Send a Service Request" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
